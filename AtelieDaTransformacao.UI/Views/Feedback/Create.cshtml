@model AtelieDaTransformacao.Application.ViewModels.FeedbackFormViewModel

@{
    ViewData["Title"] = "Avaliar produto";

    var productImage =
        string.IsNullOrWhiteSpace(Model.ProdutoImagem)
            ? "/images/placeholder.jpg"
            : Model.ProdutoImagem;
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="card-body p-4 p-md-5">

                    <div class="mb-4">

                        <span class="text-uppercase text-gold fw-bold small">
                            Sua experiência
                        </span>

                        <h1 class="serif-title fw-bold mb-2">
                            Avalie seu produto
                        </h1>

                        <p class="text-muted mb-0">
                            Pedido
                            <strong>@Model.PedidoNumero</strong>
                            · Conte como foi receber
                            <strong>@Model.ProdutoNome</strong>.
                        </p>

                    </div>

                    <div class="d-flex align-items-center gap-3 p-3 rounded-4 border bg-light mb-4">

                        <img src="@productImage"
                             alt="@Model.ProdutoNome"
                             style="width:80px;height:80px;object-fit:cover;border-radius:16px;" />

                        <div>

                            <div class="small text-muted">
                                Produto comprado
                            </div>

                            <div class="fw-bold">
                                @Model.ProdutoNome
                            </div>

                        </div>

                    </div>

                    <form asp-action="Create"
                          asp-controller="Feedback"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <input asp-for="PedidoId"
                               type="hidden" />

                        <input asp-for="ProdutoId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger rounded-4"></div>

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Nota
                                <span class="text-danger">*</span>
                            </label>

                            <div class="feedback-stars"
                                 role="radiogroup"
                                 aria-label="Escolha de 1 a 5 estrelas">

                                @for (var star = 5; star >= 1; star--)
                                {
                                    var id = $"star-{star}";

                                    <input type="radio"
                                           asp-for="Nota"
                                           id="@id"
                                           value="@star" />

                                    <label for="@id"
                                           title="@star estrela(s)">

                                        <i class="bi bi-star-fill"></i>

                                    </label>
                                }

                            </div>

                            <span asp-validation-for="Nota"
                                  class="text-danger small"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Comentario"
                                   class="form-label fw-bold">

                                Comentário
                                <span class="text-danger">*</span>

                            </label>

                            <textarea asp-for="Comentario"
                                      class="form-control rounded-4"
                                      rows="6"
                                      minlength="10"
                                      maxlength="2000"
                                      placeholder="Conte o que você achou da peça, acabamento, qualidade e experiência de compra..."></textarea>

                            <div class="d-flex justify-content-between mt-1">

                                <span asp-validation-for="Comentario"
                                      class="text-danger small"></span>

                                <small class="text-muted">
                                    Mínimo de 10 e máximo de 2000 caracteres
                                </small>

                            </div>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Imagem"
                                   class="form-label fw-bold">

                                Foto do produto

                                <span class="text-muted fw-normal">
                                    (opcional)
                                </span>

                            </label>

                            <input asp-for="Imagem"
                                   class="form-control rounded-4"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                   id="feedbackImage" />

                            <div class="form-text">
                                Se quiser, envie uma foto real do produto recebido.
                                Máximo de 5 MB.
                            </div>

                            <div id="feedbackImagePreviewContainer"
                                 class="mt-3"
                                 hidden>

                                <img id="feedbackImagePreview"
                                     src="#"
                                     alt="Pré-visualização da foto selecionada"
                                     style="max-width:260px;max-height:260px;object-fit:cover;border-radius:18px;" />

                            </div>

                            <span asp-validation-for="Imagem"
                                  class="text-danger small"></span>

                        </div>

                        <div class="form-check form-switch p-3 rounded-4 border mb-4">

                            <input asp-for="IsAnonimo"
                                   class="form-check-input ms-0 me-2"
                                   role="switch" />

                            <label asp-for="IsAnonimo"
                                   class="form-check-label fw-bold">

                                Publicar como anônimo

                            </label>

                            <div class="small text-muted mt-1">
                                Seu nome não será exibido publicamente na avaliação.
                            </div>

                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end">

                            <a asp-controller="Order"
                               asp-action="Index"
                               class="btn btn-outline-dark rounded-pill px-4">

                                Cancelar

                            </a>

                            <button type="submit"
                                    class="btn btn-artisan rounded-pill px-4">

                                <i class="bi bi-send me-1"></i>

                                Publicar avaliação

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .feedback-stars {
        display: inline-flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: .2rem;
    }

    .feedback-stars input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .feedback-stars label {
        color: #c9c9c9;
        cursor: pointer;
        font-size: 2.2rem;
        line-height: 1;
        transition:
            transform .15s ease,
            color .15s ease;
    }

    .feedback-stars label:hover,
    .feedback-stars label:hover ~ label,
    .feedback-stars input:checked ~ label {
        color: #d39b42;
    }

    .feedback-stars label:hover {
        transform: scale(1.08);
    }

</style>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        (() => {

            const input =
                document.getElementById(
                    "feedbackImage");

            const preview =
                document.getElementById(
                    "feedbackImagePreview");

            const container =
                document.getElementById(
                    "feedbackImagePreviewContainer");

            if (!input ||
                !preview ||
                !container) {
                return;
            }

            input.addEventListener(
                "change",
                () => {

                    const file =
                        input.files?.[0];

                    if (!file) {

                        preview.removeAttribute(
                            "src");

                        container.hidden = true;

                        return;
                    }

                    const allowedTypes = [
                        "image/jpeg",
                        "image/png",
                        "image/webp"
                    ];

                    if (!allowedTypes.includes(
                            file.type) ||
                        file.size >
                            5 * 1024 * 1024) {

                        preview.removeAttribute(
                            "src");

                        container.hidden = true;

                        return;
                    }

                    const url =
                        URL.createObjectURL(
                            file);

                    preview.src = url;

                    container.hidden = false;

                    preview.onload =
                        () =>
                            URL.revokeObjectURL(
                                url);
                });

        })();

    </script>
}