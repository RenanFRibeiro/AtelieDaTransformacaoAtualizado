@model AtelieDaTransformacao.Application.DTOs.ForgotPasswordDto
@{
    ViewData["Title"] = "Esqueci minha senha";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="auth-card bg-white p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="auth-logo mb-3"><i class="bi bi-shield-lock"></i></div>
                    <span class="eyebrow">RECUPERAÇÃO SEGURA</span>
                    <h1 class="serif-title fw-bold mt-2">Esqueci minha senha</h1>
                    <p class="text-muted">Informe seu e-mail e enviaremos as instruções para criar uma nova senha.</p>
                </div>

                @if (TempData["PasswordResetMessage"] is string message)
                {
                    <div class="alert alert-success rounded-3" role="status">@message</div>
                }

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control form-control-lg" type="email" autocomplete="email" placeholder="voce@email.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-artisan w-100 rounded-3 py-3 fw-semibold" type="submit">
                        <i class="bi bi-envelope me-2"></i>Enviar instruções
                    </button>
                    <a asp-action="Login" class="btn btn-outline-dark w-100 rounded-3 py-3 mt-2">
                        <i class="bi bi-arrow-left me-2"></i>Voltar para entrar
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
