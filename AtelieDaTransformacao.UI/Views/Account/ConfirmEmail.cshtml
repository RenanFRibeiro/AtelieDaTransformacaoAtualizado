@model AtelieDaTransformacao.UI.Models.ConfirmEmailViewModel
@{
    ViewData["Title"] = "Confirmar e-mail";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="auth-card bg-white p-4 p-md-5 text-center">
                <div class="auth-logo mb-3"><i class="bi bi-shield-check"></i></div>
                <span class="eyebrow">ATELIÊ DA TRANSFORMAÇÃO</span>
                <h1 class="serif-title fw-bold mt-2">Confirmar seu e-mail</h1>
                <p class="text-muted">Você está confirmando o endereço:</p>
                <div class="alert alert-light border rounded-3 fw-semibold" role="status">
                    <i class="bi bi-envelope me-2"></i>@Model.Email
                </div>
                <p class="small text-muted">Por segurança, o link foi apenas aberto nesta etapa. A confirmação será concluída quando você clicar no botão abaixo.</p>
                <form asp-action="ConfirmEmailPost" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />
                    <button type="submit" class="btn btn-artisan btn-lg w-100 rounded-3 py-3">
                        <i class="bi bi-check-circle me-2"></i>Confirmar e-mail
                    </button>
                </form>
                <a asp-action="Login" class="btn btn-outline-dark w-100 rounded-3 mt-2">Voltar para entrar</a>
            </div>
        </div>
    </div>
</div>
