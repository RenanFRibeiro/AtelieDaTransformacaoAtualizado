@model AtelieDaTransformacao.Application.DTOs.RegisterDto

@{
    ViewData["Title"] = "Criar sua conta";
    var returnUrl = ViewBag.ReturnUrl as string;
    var registrationReason = ViewBag.RegistrationReason as string;
}

<div class="container py-5 py-lg-6">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="auth-shell overflow-hidden">
                <div class="row g-0">
                    <div class="col-lg-4 auth-aside">
                        <div class="h-100 p-4 p-lg-5 d-flex flex-column">
                            <span class="eyebrow text-white-50">ATELIÊ DA TRANSFORMAÇÃO</span>
                            <h1 class="serif-title display-6 text-white fw-bold mt-3">Sua conta, seu espaço.</h1>
                            <p class="text-white-50 mt-3">Cadastre seus dados uma única vez para comprar pelo site, acompanhar pedidos e falar com o vendedor com mais facilidade.</p>

                            <div class="mt-4 d-grid gap-3">
                                <div class="d-flex gap-3 align-items-start">
                                    <span class="auth-feature-icon"><i class="bi bi-person-check"></i></span>
                                    <div><strong class="text-white">Cadastro completo</strong><div class="text-white-50 small">Seus dados ficam vinculados ao seu perfil.</div></div>
                                </div>
                                <div class="d-flex gap-3 align-items-start">
                                    <span class="auth-feature-icon"><i class="bi bi-box-seam"></i></span>
                                    <div><strong class="text-white">Acompanhe seus pedidos</strong><div class="text-white-50 small">Veja cada etapa da compra pelo site.</div></div>
                                </div>
                                <div class="d-flex gap-3 align-items-start">
                                    <span class="auth-feature-icon"><i class="bi bi-whatsapp"></i></span>
                                    <div><strong class="text-white">Contato direto</strong><div class="text-white-50 small">Fale com o vendedor pelo WhatsApp quando precisar.</div></div>
                                </div>
                            </div>

                            <div class="mt-auto pt-5">
                                <span class="small text-white-50">Já possui uma conta?</span>
                                <a asp-action="Login" asp-route-returnUrl="@returnUrl" class="btn btn-light w-100 rounded-3 mt-2">Entrar na minha conta</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-8 bg-white">
                        <div class="p-4 p-lg-5">
                            <div class="mb-4">
                                <span class="text-uppercase text-muted small fw-bold">Novo cadastro</span>
                                <h2 class="serif-title fw-bold mt-1 mb-2">Crie seu perfil</h2>
                                <p class="text-muted mb-0">Preencha seus dados para deixar sua experiência de compra mais rápida e organizada.</p>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(registrationReason))
                            {
                                <div class="alert alert-warning border-0 rounded-4 mb-4" role="alert">
                                    <div class="d-flex gap-3 align-items-start">
                                        <i class="bi bi-info-circle-fill fs-5 text-warning"></i>
                                        <div>
                                            <strong>Por que preciso me cadastrar?</strong>
                                            <div class="small mt-1">@registrationReason</div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <form asp-action="Register" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                                <div class="auth-section-title"><span>1</span><div><strong>Dados pessoais</strong><small>Como podemos chamar você?</small></div></div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="FirstName" class="form-label"></label>
                                        <input asp-for="FirstName" class="form-control form-control-lg" autocomplete="given-name" placeholder="Seu nome" />
                                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="LastName" class="form-label"></label>
                                        <input asp-for="LastName" class="form-control form-control-lg" autocomplete="family-name" placeholder="Seu sobrenome" />
                                        <span asp-validation-for="LastName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Phone" class="form-label"></label>
                                        <input asp-for="Phone" class="form-control form-control-lg" autocomplete="tel" inputmode="tel" placeholder="(11) 99999-9999" />
                                        <span asp-validation-for="Phone" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="auth-section-title mt-4"><span>2</span><div><strong>Endereço</strong><small>Para pedidos e entregas</small></div></div>
                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <label asp-for="Address" class="form-label"></label>
                                        <input asp-for="Address" class="form-control form-control-lg" autocomplete="street-address" placeholder="Rua, avenida ou estrada" />
                                        <span asp-validation-for="Address" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AddressNumber" class="form-label"></label>
                                        <input asp-for="AddressNumber" class="form-control form-control-lg" autocomplete="address-line2" placeholder="Nº" />
                                        <span asp-validation-for="AddressNumber" class="text-danger small"></span>
                                    </div><div class="col-md-6">
                                        <label asp-for="District" class="form-label"></label>
                                        <input asp-for="District" class="form-control form-control-lg" autocomplete="address-level3" placeholder="Bairro" />
                                        <span asp-validation-for="District" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-5">
                                        <label asp-for="City" class="form-label"></label>
                                        <input asp-for="City" class="form-control form-control-lg" autocomplete="address-level2" placeholder="Cidade" />
                                        <span asp-validation-for="City" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="State" class="form-label"></label>
                                        <input asp-for="State" class="form-control form-control-lg text-uppercase" maxlength="2" autocomplete="address-level1" placeholder="SP" />
                                        <span asp-validation-for="State" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="PostalCode" class="form-label"></label>
                                        <div class="input-group input-group-lg">
                                            <input asp-for="PostalCode" class="form-control" maxlength="9" autocomplete="postal-code" inputmode="numeric" placeholder="00000-000" />
                                            <span class="input-group-text cep-status" id="cepStatus" aria-live="polite"><i class="bi bi-search"></i></span>
                                        </div>
                                        <small class="form-text text-muted">Digite o CEP para preencher endereço, bairro, cidade e UF automaticamente.</small>
                                        <span asp-validation-for="PostalCode" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="auth-section-title mt-4"><span>3</span><div><strong>Acesso à conta</strong><small>Seus dados de login</small></div></div>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label asp-for="Email" class="form-label"></label>
                                        <input asp-for="Email" class="form-control form-control-lg" type="email" autocomplete="email" placeholder="voce@email.com" />
                                        <span asp-validation-for="Email" class="text-danger small"></span> 
                                        <div id="emailValidationStatus" class="small mt-1" aria-live="polite"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Password" class="form-label"></label>
                                        <div class="input-group input-group-lg">
                                            <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" placeholder="8+ caracteres, com maiúscula, minúscula, número e símbolo" />
                                            <button type="button" class="btn btn-outline-secondary toggle-password" data-target="Password" aria-label="Mostrar ou ocultar senha"><i class="bi bi-eye"></i></button>
                                        </div>
                                        <span asp-validation-for="Password" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="ConfirmPassword" class="form-label"></label>
                                        <div class="input-group input-group-lg">
                                            <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" placeholder="Repita sua senha" />
                                            <button type="button" class="btn btn-outline-secondary toggle-password" data-target="ConfirmPassword" aria-label="Mostrar ou ocultar confirmação da senha"><i class="bi bi-eye"></i></button>
                                        </div>
                                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="terms-consent mt-4">
                                    <label class="terms-check">
                                        <input asp-for="AcceptTerms" required />
                                        <span class="terms-check-box" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                                        <span class="terms-check-text">
                                            <strong>Quase pronto!</strong>
                                            <span>Li e aceito os <a asp-controller="Home" asp-action="Terms" target="_blank" rel="noopener">Termos de Uso</a> e a <a asp-controller="Home" asp-action="Privacy" target="_blank" rel="noopener">Política de Privacidade</a>.</span>
                                        </span>
                                    </label>
                                    <span asp-validation-for="AcceptTerms" class="text-danger small d-block mt-2"></span>
                                </div>
                                <button type="submit" class="btn btn-artisan btn-lg w-100 rounded-3 mt-4 py-3">
                                    <i class="bi bi-person-plus me-2"></i> Criar minha conta
                                </button>
                                <p class="small text-muted text-center mt-3 mb-0">
                                    Ao continuar, você cria uma conta para comprar e acompanhar seus pedidos no site.
                                </p>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.toggle-password').forEach(function (button) {
            button.addEventListener('click', function () {
                const input = document.getElementById(button.dataset.target);
                const icon = button.querySelector('i');
                if (!input) return;
                const showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                icon.className = showing ? 'bi bi-eye' : 'bi bi-eye-slash';
                button.setAttribute('aria-label', showing ? 'Mostrar senha' : 'Esconder senha');
            });
        });

        const state = document.querySelector('input[name="State"]');
        const cep = document.querySelector('input[name="PostalCode"]');
        const phone = document.querySelector('input[name="Phone"]');
        const address = document.querySelector('input[name="Address"]');
        const district = document.querySelector('input[name="District"]');
        const city = document.querySelector('input[name="City"]');
        const status = document.getElementById('cepStatus');
        let cepTimer;

        state?.addEventListener('input', function () { this.value = this.value.toUpperCase().replace(/[^A-Z]/g, '').slice(0, 2); });
        phone?.addEventListener('input', function () {
            const digits = this.value.replace(/\D/g, '').slice(0, 11);
            this.value = digits.length <= 10
                ? digits.replace(/(\d{2})(\d{4})(\d{0,4})/, '($1) $2-$3').replace(/-$/, '')
                : digits.replace(/(\d{2})(\d{5})(\d{0,4})/, '($1) $2-$3').replace(/-$/, '');
        });

        async function buscarCep() {
            const digits = (cep?.value || '').replace(/\D/g, '');
            if (digits.length !== 8) return;
            if (status) status.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>';
            try {
                const response = await fetch('@Url.Action("BuscarEndereco", "Cep")?cep=' + encodeURIComponent(digits), { headers: { 'Accept': 'application/json' } });
                const data = await response.json();
                if (data.erro) throw new Error(data.mensagem || 'CEP não encontrado.');
                if (address && data.logradouro) address.value = data.logradouro;
                if (district && data.bairro) district.value = data.bairro;
                if (city && data.cidade) city.value = data.cidade;
                if (state && data.estado) state.value = data.estado.toUpperCase();
                if (status) status.innerHTML = '<i class="bi bi-check-circle-fill text-success" title="Endereço localizado"></i>';
                [address, district, city, state].forEach(el => el?.dispatchEvent(new Event('change', { bubbles: true })));
            } catch (error) {
                if (status) status.innerHTML = '<i class="bi bi-exclamation-circle text-warning" title="Não foi possível localizar o CEP"></i>';
            }
        }

        cep?.addEventListener('input', function () {
            const digits = this.value.replace(/\D/g, '').slice(0, 8);
            this.value = digits.length > 5 ? digits.slice(0, 5) + '-' + digits.slice(5) : digits;
            clearTimeout(cepTimer);
            if (digits.length === 8) cepTimer = setTimeout(buscarCep, 250);
        });
        cep?.addEventListener('blur', buscarCep);

        const registerEmail = document.getElementById('Email');
        const emailValidationStatus = document.getElementById('emailValidationStatus');
        let emailValidationTimer;

        registerEmail?.addEventListener('input', function () {
            clearTimeout(emailValidationTimer);
            const value = this.value.trim();
            emailValidationStatus.textContent = '';
            emailValidationStatus.className = 'small mt-1';
            if (!value) return;

            emailValidationTimer = setTimeout(async () => {
                try {
                    emailValidationStatus.textContent = 'Validando e-mail...';
                    const response = await fetch(`/api/email-validation/validate?email=${encodeURIComponent(value)}`);
                    const result = await response.json();
                    emailValidationStatus.textContent = result.message;
                    emailValidationStatus.classList.add(result.valid ? 'text-success' : 'text-danger');
                } catch {
                    emailValidationStatus.textContent = 'Não foi possível validar agora. Você ainda pode continuar.';
                    emailValidationStatus.classList.add('text-muted');
                }
            }, 450);
        });

    </script>
}
