@model AtelieDaTransformacao.Application.DTOs.LoginDto

@{
    ViewData["Title"] = "Entrar";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5 col-xl-4">
            <div class="auth-card bg-white p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="auth-logo mb-3"><i class="bi bi-person-circle"></i></div>
                    <span class="eyebrow">ATELIÊ DA TRANSFORMAÇÃO</span>
                    <h1 class="serif-title fw-bold mt-2 mb-2">Bem-vindo de volta</h1>
                    <p class="text-muted mb-0">Entre para acompanhar seus pedidos e continuar suas compras.</p>
                </div>
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control form-control-lg" type="email" autocomplete="email" placeholder="voce@email.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group input-group-lg">
                            <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" placeholder="Sua senha" />
                            <button type="button" class="btn btn-outline-secondary toggle-password" data-target="Password" aria-label="Mostrar ou ocultar senha"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span> 
                        <div class="text-end mt-2">
                            <a asp-action="ForgotPassword" class="small fw-semibold link-artisan">Esqueci minha senha</a>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-artisan btn-lg w-100 rounded-3 py-3">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Entrar
                    </button>
                </form>
                <div class="text-center mt-4">
                    <p class="small text-muted mb-2">Ainda não tem uma conta?</p>
                    <a asp-action="Register" asp-route-returnUrl="@returnUrl" class="btn btn-outline-artisan-light w-100 rounded-3">Criar minha conta</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.toggle-password').forEach(function (button) {
            button.addEventListener('click', function () {
                const input = document.getElementById(button.dataset.target);
                const icon = button.querySelector('i');
                if (!input) return;
                const showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                icon.className = showing ? 'bi bi-eye' : 'bi bi-eye-slash';
            });
        });
    </script>
}
