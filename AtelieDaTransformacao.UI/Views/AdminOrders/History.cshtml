@model IReadOnlyList<AtelieDaTransformacao.Application.DTOs.OrderListDto>
@using AtelieDaTransformacao.Domain.Enums
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Histórico de pedidos";
    var selectedStatus = ViewBag.Status as OrderStatus?;
    var client = ViewBag.Client as string;
    var startDate = ViewBag.StartDate as string;
    var endDate = ViewBag.EndDate as string;
    var historyOrders = Model;
    var sent = historyOrders.Count(x => x.Status == OrderStatus.Enviado);
    var delivered = historyOrders.Count(x => x.Status == OrderStatus.Entregue);
    var cancelled = historyOrders.Count(x => x.Status == OrderStatus.Cancelado);
    var total = historyOrders.Sum(x => x.Total);
}

<div class="admin-page-head">
    <div>
        <span class="admin-eyebrow">GESTÃO</span>
        <h1>Histórico de pedidos</h1>
        <p>Pedidos enviados, entregues e cancelados ficam aqui e deixam automaticamente o painel ativo.</p>
    </div>
    <div class="admin-page-actions">
        <a asp-action="Index" class="btn btn-outline-dark rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i>Pedidos ativos
        </a>
        <a id="exportHistory" class="btn btn-dark rounded-pill px-4" href="#">
            <i class="bi bi-download me-2"></i>Exportar CSV
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><small class="text-muted">Enviados</small><div class="fs-3 fw-bold">@sent</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><small class="text-muted">Entregues</small><div class="fs-3 fw-bold">@delivered</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><small class="text-muted">Cancelados</small><div class="fs-3 fw-bold">@cancelled</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><small class="text-muted">Valor filtrado</small><div class="fs-3 fw-bold">R$ @total.ToString("N2")</div></div></div></div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="History" class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label small text-muted">Status</label>
                <select class="form-select" name="status">
                    <option value="">Todos</option>
                    <option value="Enviado" selected="@(selectedStatus == OrderStatus.Enviado)">Enviado</option>
                    <option value="Entregue" selected="@(selectedStatus == OrderStatus.Entregue)">Entregue</option>
                    <option value="Cancelado" selected="@(selectedStatus == OrderStatus.Cancelado)">Cancelado</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small text-muted">Cliente / pedido</label>
                <input class="form-control" name="client" value="@client" placeholder="Nome, e-mail ou nº do pedido" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted">De</label>
                <input class="form-control" type="date" name="startDate" value="@startDate" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted">Até</label>
                <input class="form-control" type="date" name="endDate" value="@endDate" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button class="btn btn-dark rounded-pill flex-grow-1" type="submit"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                <a asp-action="History" class="btn btn-outline-secondary rounded-pill" title="Limpar filtros"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="admin-section-head">
        <div>
            <h2 class="admin-section-title">Pedidos arquivados</h2>
            <p class="admin-section-subtitle">O histórico é atualizado automaticamente quando um pedido sai do fluxo ativo.</p>
        </div>
        <span class="admin-badge featured"><i class="bi bi-check2-circle"></i>@Model.Count pedido(s)</span>
    </div>

    @if (!Model.Any())
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
            <h3 class="h5">Nenhum pedido encontrado</h3>
            <p class="mb-0">Ajuste os filtros ou aguarde pedidos serem enviados, entregues ou cancelados.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-uppercase text-muted">
                        <th class="ps-4">Pedido</th>
                        <th>Cliente</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Atualizado em</th>
                        <th class="text-center pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr id="history-order-@order.Id">
                        <td class="ps-4"><strong>@order.OrderNumber</strong><small class="text-muted d-block">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                        <td><span class="d-block">@order.CustomerName</span><small class="text-muted">@order.UserEmail</small></td>
                        <td class="fw-semibold">R$ @order.Total.ToString("N2")</td>
                        <td>
                            <span class="badge rounded-pill px-3 py-2 @(order.Status == OrderStatus.Cancelado ? "bg-danger" : order.Status == OrderStatus.Entregue ? "bg-success" : "bg-secondary")">
                                @order.StatusName
                            </span>
                        </td>
                        <td>@order.StatusChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center pe-4">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary rounded-pill"><i class="bi bi-eye me-1"></i>Ver</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>
<script>
(() => {
    const params = new URLSearchParams();
    const status = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedStatus?.ToString()));
    const client = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(client ?? ""));
    const startDate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(startDate ?? ""));
    const endDate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(endDate ?? ""));
    if (status) params.set('status', status);
    if (client) params.set('client', client);
    if (startDate) params.set('startDate', startDate);
    if (endDate) params.set('endDate', endDate);
    document.getElementById('exportHistory').href = '@Url.Action("ExportHistory", "AdminOrders")' + (params.toString() ? '?' + params.toString() : '');

    if (typeof signalR === 'undefined') return;
    const connection = new signalR.HubConnectionBuilder().withUrl('/hubs/orders').withAutomaticReconnect().build();
    connection.on('AdminOrderStatusUpdated', data => {
        const row = document.getElementById(`history-order-${data.orderId}`);
        const isHistory = [5, 6, 7].includes(Number(data.status));
        if (isHistory) {
            window.location.reload();
        } else if (row) {
            window.location.reload();
        }
    });
    connection.start().catch(error => console.error('SignalR histórico:', error));
})();
</script>
