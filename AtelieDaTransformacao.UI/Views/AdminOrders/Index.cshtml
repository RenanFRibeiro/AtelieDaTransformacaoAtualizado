@model IReadOnlyList<AtelieDaTransformacao.Application.DTOs.OrderListDto>
@using AtelieDaTransformacao.Domain.Enums
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Pedidos";
    var statuses = Enum.GetValues<OrderStatus>();
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark m-0">Pedidos</h2>
        <p class="text-muted small m-0">Altere manualmente ou ative a progressão automática de cada pedido.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill">Ver loja</a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-uppercase text-muted">
                    <th class="ps-4">Pedido</th>
                    <th>Cliente</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Automação</th>
                    <th class="text-end pe-4">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <strong>@order.OrderNumber</strong>
                            <small class="text-muted d-block">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </td>
                        <td class="small">@order.UserEmail</td>
                        <td class="fw-semibold">R$ @order.Total.ToString("N2")</td>
                        <td>
                            <form asp-action="SetStatus" method="post" class="d-flex gap-2 align-items-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@order.Id" />
                                <input type="hidden" name="autoAdvance" value="@order.AutoAdvance.ToString().ToLowerInvariant()" />
                                <select name="status" class="form-select form-select-sm" style="min-width: 150px;">
                                    @foreach (var status in statuses)
                                    {
                                        if (status == order.Status)
                                        {
                                            <option value="@((int)status)" selected>@status.ToDisplayName()</option>
                                        }
                                        else
                                        {
                                            <option value="@((int)status)">@status.ToDisplayName()</option>
                                        }
                                    }
                                </select>
                                <button class="btn btn-sm btn-dark rounded-pill">Salvar</button>
                            </form>
                        </td>
                        <td>
                            <form asp-action="ToggleAutomation" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@order.Id" />
                                <input type="hidden" name="enabled" value="@(!order.AutoAdvance).ToString().ToLowerInvariant()" />
                                <button class="btn btn-sm rounded-pill @(order.AutoAdvance ? "btn-success" : "btn-outline-secondary")">
                                    <i class="bi bi-arrow-repeat me-1"></i>@(order.AutoAdvance ? "Ativa" : "Manual")
                                </button>
                            </form>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-2">
                                @if (order.Status != OrderStatus.Entregue)
                                {
                                    <form asp-action="Advance" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <button class="btn btn-sm btn-outline-primary rounded-pill">Avançar</button>
                                    </form>
                                }
                                <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" target="_blank" class="btn btn-sm btn-outline-dark rounded-pill">Abrir</a>
                            </div>
                        </td>

                        <td class="text-end pe-4">

                            <div class="d-inline-flex flex-wrap gap-2">

                                @if (order.Status != OrderStatus.Entregue &&
                                     order.Status != OrderStatus.Cancelado)
                                {
                                    <form asp-action="Advance"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@order.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-primary rounded-pill">

                                            Avançar

                                        </button>

                                    </form>
                                }

                                @if (order.Status.CanCancel())
                                {
                                    <form asp-action="Cancel"
                                          method="post"
                                          onsubmit="return confirm('Cancelar este pedido e devolver o estoque?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@order.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger rounded-pill">

                                            <i class="bi bi-x-circle me-1"></i>

                                            Cancelar

                                        </button>

                                    </form>
                                }
                                else if (order.Status == OrderStatus.Cancelado)
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">

                                        Cancelado

                                    </span>
                                }

                                <a asp-controller="AdminOrders"
                                   asp-action="Details"
                                   asp-route-id="@order.Id"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-dark rounded-pill">

                                    Abrir

                                </a>

                            </div>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="alert alert-light border mt-4 small">
    <strong>Automação:</strong> quando ativada, o sistema avança o pedido automaticamente em intervalos pré-configurados. O administrador pode intervir manualmente a qualquer momento.
</div>
