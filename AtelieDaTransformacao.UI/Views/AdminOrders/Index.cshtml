@model IReadOnlyList<AtelieDaTransformacao.Application.DTOs.OrderListDto>
@using AtelieDaTransformacao.Domain.Enums
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Pedidos";
    var statuses = Enum.GetValues<OrderStatus>();
}

<div class="admin-page-head">
    <div>
        <h1>Pedidos</h1>
        <p>Acompanhe o fluxo dos pedidos e altere o status manualmente ou pela automação.</p>
    </div>
    <div class="admin-page-actions">
        <button type="button" 
                class="btn btn-success rounded-pill px-4" 
                id="btnAdvanceAutomatic"
                onclick="advanceAllAutomatic()">
            <i class="bi bi-arrow-repeat me-1"></i>Avançar Automáticos
        </button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4"><i class="bi bi-shop me-2"></i>Ver loja</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" id="alertSuccess">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" id="alertError">@error</div>
}

<div id="autoAdvanceAlert"></div>

<div class="card mb-4">
    <div class="admin-section-head">
        <div>
            <h2 class="admin-section-title">Fluxo de pedidos</h2>
            <p class="admin-section-subtitle">Atualize o status, controle a automação e abra os detalhes de cada pedido.</p>
        </div>
        <span class="admin-badge featured"><i class="bi bi-arrow-repeat"></i>Automação disponível</span>
    </div>

<div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-uppercase text-muted">
                    <th class="ps-4">Pedido</th>
                    <th>Cliente</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Automação</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr id="order-@order.Id">
                        <td class="ps-4">
                            <strong>@order.OrderNumber</strong>
                            <small class="text-muted d-block">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </td>
                        <td class="small">@order.UserEmail</td>
                        <td class="fw-semibold">R$ @order.Total.ToString("N2")</td>
                        <td>
                            <form asp-action="SetStatus" method="post" class="d-flex gap-2 align-items-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@order.Id" />
                                <input type="hidden" name="autoAdvance" value="@order.AutoAdvance.ToString().ToLowerInvariant()" />
                                <select name="status" class="form-select form-select-sm" style="min-width: 155px;">
                                    @foreach (var status in statuses)
                                    {
                                        if (status == order.Status)
                                        {
                                            <option value="@((int)status)" selected>@status.ToDisplayName()</option>
                                        }
                                        else
                                        {
                                            <option value="@((int)status)">@status.ToDisplayName()</option>
                                        }
                                    }
                                </select>
                                <button class="btn btn-sm btn-dark rounded-pill">Salvar</button>
                            </form>
                        </td>
                        <td>
                            <form asp-action="ToggleAutomation" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@order.Id" />
                                <input type="hidden" name="enabled" value="@(!order.AutoAdvance).ToString().ToLowerInvariant()" />
                                <button class="btn btn-sm rounded-pill @(order.AutoAdvance ? "btn-success" : "btn-outline-secondary")">
                                    <i class="bi bi-arrow-repeat me-1"></i>@(order.AutoAdvance ? "Ativa" : "Manual")
                                </button>
                            </form>
                        </td>
                        <td class="text-center pe-4">
                            <div class="d-flex gap-2 justify-content-center flex-nowrap">
                                
                                <!-- BOTÃO AVANÇAR (Individual) -->
                                @if (order.Status != OrderStatus.Entregue &&
                                     order.Status != OrderStatus.Cancelado)
                                {
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-primary rounded-pill" 
                                            onclick="advanceIndividual(@order.Id)"
                                            id="btnAdvance-@order.Id">
                                        <i class="bi bi-arrow-right me-1"></i>Avançar
                                    </button>
                                }
                                else
                                {
                                    <span class="btn btn-sm btn-outline-secondary rounded-pill disabled">
                                        <i class="bi bi-arrow-right me-1"></i>Avançar
                                    </span>
                                }

                                <!-- BOTÃO CANCELAR -->
                                @if (order.Status.CanCancel())
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger rounded-pill"
                                            onclick="if (confirm('Cancelar este pedido e devolver o estoque?')) { cancelOrder(@order.Id); }"
                                            id="btnCancel-@order.Id">
                                        <i class="bi bi-x-circle me-1"></i>Cancelar
                                    </button>
                                }
                                else if (order.Status == OrderStatus.Cancelado)
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        <i class="bi bi-x-circle me-1"></i>Cancelado
                                    </span>
                                }
                                else
                                {
                                    <span class="btn btn-sm btn-outline-secondary rounded-pill disabled">
                                        <i class="bi bi-x-circle me-1"></i>Cancelar
                                    </span>
                                }

                                <!-- BOTÃO VER -->
                                <a asp-controller="AdminOrders"
                                   asp-action="Details"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-secondary rounded-pill">
                                    <i class="bi bi-eye me-1"></i>Ver
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

</div>

<script>
// =========================================================
// AVANÇAR AUTOMÁTICOS (Todos com AutoAdvance = true)
// =========================================================
async function advanceAllAutomatic() {
    const btn = document.getElementById('btnAdvanceAutomatic');
    const alertDiv = document.getElementById('autoAdvanceAlert');
    
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Processando...';
    
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        
        const response = await fetch('@Url.Action("AdvanceAutomatic", "AdminOrders")', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token,
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: new URLSearchParams({
                '__RequestVerificationToken': token
            })
        });
        
        const data = await response.json();
        
        if (data.success) {
            alertDiv.innerHTML = `
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>
                    ${data.message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            
            // Recarrega a página após 2 segundos
            setTimeout(() => location.reload(), 2000);
        } else {
            alertDiv.innerHTML = `
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    Erro ao avançar pedidos automáticos.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
        }
    } catch (error) {
        console.error('Erro:', error);
        alertDiv.innerHTML = `
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                Erro na requisição: ${error.message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `;
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Avançar Automáticos';
    }
}

// =========================================================
// AVANÇAR PEDIDO INDIVIDUAL (sem recarregar página)
// =========================================================
async function advanceIndividual(orderId) {
    const btn = document.getElementById(`btnAdvance-${orderId}`);
    const row = document.getElementById(`order-${orderId}`);
    
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Processando...';
    
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        
        const response = await fetch('@Url.Action("Advance", "AdminOrders")', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token,
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: new URLSearchParams({
                '__RequestVerificationToken': token,
                'id': orderId
            })
        });
        
        if (response.ok) {
            // Mostra feedback visual
            row.style.backgroundColor = '#d4edda';
            
            setTimeout(() => {
                row.style.backgroundColor = '';
                location.reload(); // Recarrega para atualizar status
            }, 1500);
        } else {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-right me-1"></i>Avançar';
            alert('Erro ao avançar pedido. Tente novamente.');
        }
    } catch (error) {
        console.error('Erro:', error);
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-arrow-right me-1"></i>Avançar';
        alert('Erro na requisição: ' + error.message);
    }
}

// =========================================================
// CANCELAR PEDIDO INDIVIDUAL (sem recarregar página)
// =========================================================
async function cancelOrder(orderId) {
    const btn = document.getElementById(`btnCancel-${orderId}`);
    const row = document.getElementById(`order-${orderId}`);
    
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Cancelando...';
    
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        
        const response = await fetch('@Url.Action("Cancel", "AdminOrders")', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token,
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: new URLSearchParams({
                '__RequestVerificationToken': token,
                'id': orderId
            })
        });
        
        if (response.ok) {
            // Mostra feedback visual
            row.style.backgroundColor = '#f8d7da';
            
            setTimeout(() => {
                row.style.backgroundColor = '';
                location.reload(); // Recarrega para atualizar status
            }, 1500);
        } else {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-x-circle me-1"></i>Cancelar';
            alert('Erro ao cancelar pedido. Tente novamente.');
        }
    } catch (error) {
        console.error('Erro:', error);
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-x-circle me-1"></i>Cancelar';
        alert('Erro na requisição: ' + error.message);
    }
}
</script>
