@{
    ViewData["Title"] = "Sobre o Ateliê";
}

<section class="about-hero">
    <div class="container">
        <div class="about-hero-copy">
            <span class="eyebrow">NOSSA HISTÓRIA</span>
            <h1 class="serif-title">Artesanato que transforma espaços em histórias.</h1>
            <p>O Ateliê da Transformação une matéria-prima, técnica e sensibilidade para criar peças com identidade, acabamento cuidadoso e propósito.</p>
            <div class="about-hero-actions">
                <a asp-controller="Home" asp-action="Gallery" class="btn btn-artisan rounded-pill px-4 py-3">Conheça nossos projetos <i class="bi bi-arrow-up-right ms-2"></i></a>
                <a asp-controller="Quote" asp-action="Index" class="about-text-link">Criar um projeto personalizado <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</section>

<section class="container py-5 py-lg-6">
    <div class="row g-5 align-items-center">
        <div class="col-lg-6">
            <div class="about-story-card">
                <span class="about-story-number">01</span>
                <span class="eyebrow">O ATELIÊ</span>
                <h2 class="serif-title">Cada peça começa com uma ideia.</h2>
                <p>Transformamos referências, necessidades e ambientes em criações artesanais pensadas para durar e fazer sentido na rotina de quem escolhe.</p>
                <p>Do primeiro contato ao acabamento final, valorizamos comunicação clara, personalização e atenção aos detalhes.</p>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="about-principles-grid">
                <article class="about-principle"><i class="bi bi-gem"></i><h3>Exclusividade</h3><p>Projetos que respeitam o seu espaço e sua intenção.</p></article>
                <article class="about-principle"><i class="bi bi-tools"></i><h3>Feito à mão</h3><p>Processo artesanal com cuidado em cada etapa.</p></article>
                <article class="about-principle"><i class="bi bi-chat-heart"></i><h3>Atendimento próximo</h3><p>Você acompanha as decisões e conversa diretamente conosco.</p></article>
                <article class="about-principle"><i class="bi bi-arrow-repeat"></i><h3>Transformação</h3><p>Reaproveitar, renovar e criar novas possibilidades para materiais e ambientes.</p></article>
            </div>
        </div>
    </div>
</section>

<section class="about-location-section">
    <div class="container py-5 py-lg-6">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-5">
                <div class="about-location-card h-100">
                    <span class="eyebrow">ONDE ESTAMOS</span>
                    <h2 class="serif-title">Visite o Ateliê.</h2>
                    <p>Se quiser conhecer o espaço, estamos em:</p>
                    <address>R. Camomila, 99 - Antigo 375<br>Jardim Helena, São Paulo - SP<br>CEP 08090-530</address>
                    <a class="about-text-link" href="https://www.google.com/maps/search/?api=1&query=R.+Camomila%2C+99+-+Antigo+375+-+Jardim+Helena%2C+S%C3%A3o+Paulo+-+SP%2C+08090-530" target="_blank" rel="noopener noreferrer">Abrir no mapa <i class="bi bi-arrow-up-right"></i></a>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="about-map-wrap">
                    <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=-46.4232%2C-23.4791%2C-46.4211%2C-23.4775&layer=mapnik&marker=-23.4783122%2C-46.4221756" loading="lazy" title="Localização do Ateliê da Transformação"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>
