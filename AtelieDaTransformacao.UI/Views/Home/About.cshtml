@{ ViewData["Title"] = "Sobre o Ateliê"; }
<section class="page-hero text-center py-5 mb-5">
    <div class="container"><span class="eyebrow">NOSSA HISTÓRIA</span><h1 class="display-4 serif-title fw-bold mt-2">Matéria-prima, técnica e transformação.</h1><p class="lead text-muted mx-auto" style="max-width:760px">Criamos peças que valorizam o feito à mão e transformam ambientes em espaços com identidade.</p></div>
</section>
<div class="container pb-5">
    <div class="row g-5 align-items-center mb-5"><div class="col-lg-6"><div class="about-art-placeholder"><i class="bi bi-tree-fill"></i></div></div><div class="col-lg-6"><span class="eyebrow">O ATELIÊ</span><h2 class="serif-title fw-bold display-6">Cada peça carrega uma história.</h2><p class="text-muted lh-lg">O Ateliê da Transformação nasceu da ideia de unir materiais naturais, criatividade e cuidado artesanal. Nosso objetivo é criar peças que não sejam apenas bonitas, mas que façam parte da história de quem as escolhe.</p><p class="text-muted lh-lg">Trabalhamos com projetos exclusivos, peças sob encomenda e soluções personalizadas para diferentes ambientes.</p><a asp-controller="Quote" asp-action="Index" class="btn btn-artisan rounded-pill px-4 py-3">Conversar sobre um projeto <i class="bi bi-arrow-right ms-2"></i></a></div></div>
    <div class="row g-4"><div class="col-md-4"><div class="value-card"><i class="bi bi-gem"></i><h4>Exclusividade</h4><p>Cada criação recebe atenção aos detalhes e pode ser personalizada.</p></div></div><div class="col-md-4"><div class="value-card"><i class="bi bi-tools"></i><h4>Feito à mão</h4><p>Processo artesanal com cuidado em cada etapa da produção.</p></div></div><div class="col-md-4"><div class="value-card"><i class="bi bi-chat-heart"></i><h4>Atendimento próximo</h4><p>Você conversa diretamente para transformar sua ideia em realidade.</p></div></div></div>
</div>

