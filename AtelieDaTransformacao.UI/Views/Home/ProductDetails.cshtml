@model AtelieDaTransformacao.Application.DTOs.ProductDto

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5 mt-2">
    <div class="row g-5">
        <div class="col-12 col-lg-6">
            <div class="rounded-4 bg-white border p-2 shadow-sm overflow-hidden">
                <img src="@(string.IsNullOrEmpty(Model.Image) ? "/images/placeholder.jpg" : Model.Image)"
                     class="img-fluid rounded-3 w-100 object-fit-cover" style="max-height: 500px;" alt="@Model.Title" />
            </div>
        </div>

        <div class="col-12 col-lg-6 d-flex flex-column justify-content-center">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted small">Coleção</a></li>
                    <li class="breadcrumb-item active text-gold small fw-bold" aria-current="page">@Model.CategoryName</li>
                </ol>
            </nav>
            
            <h1 class="display-5 serif-title fw-bold text-dark mb-3">@Model.Title</h1>
            
            <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
                <span class="text-muted small d-block mb-1">Preço avaliado de aquisição</span>
                <h2 class="text-dark fw-bold serif-title m-0">@Model.Price.ToString("C")</h2>
            </div>

            <h6 class="fw-bold text-uppercase tracking-wider text-secondary mb-2" style="font-size: 0.8rem;">Detalhes da peça</h6>
            <p class="text-secondary lh-lg fs-6 mb-4">@Model.Description</p>
            <div class="row row-cols-2 g-2 mb-4 small"><div class="col"><div class="border rounded-3 p-3 bg-white"><strong>Produção</strong><br/><span class="text-muted">Artesanal</span></div></div><div class="col"><div class="border rounded-3 p-3 bg-white"><strong>Categoria</strong><br/><span class="text-muted">@Model.CategoryName</span></div></div><div class="col"><div class="border rounded-3 p-3 bg-white"><strong>Disponibilidade</strong><br/><span class="text-muted">@(Model.IsAvailable ? "Consulte disponibilidade" : "Sob consulta")</span></div></div><div class="col"><div class="border rounded-3 p-3 bg-white"><strong>Personalização</strong><br/><a asp-controller="Quote" asp-action="Index" class="text-decoration-none">Solicitar orçamento</a></div></div></div>

            <div class="p-4 bg-light rounded-4 border">
                <div class="d-flex gap-3 align-items-start mb-4">
                    <i class="bi bi-patch-check-fill text-gold fs-4"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Certificado de Autenticidade Manual</h6>
                        <p class="small text-muted m-0">Por se tratar de um trabalho puramente orgânico, os veios e nós apresentados na fotografia são exclusivos deste lote. O envio é estruturado sob medida.</p>
                    </div>
                </div>
                
                @if (Model.IsAvailable && Model.StockQuantity > 0)
                {
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="row g-2">
                                <div class="col-4">
                                    <label for="quantity" class="form-label small fw-semibold">Quantidade</label>
                                    <input id="quantity" name="quantity" type="number" min="1" max="@Model.StockQuantity" value="1" class="form-control form-control-lg" />
                                </div>
                                <div class="col-8 d-flex align-items-end">
                                    <button type="submit" class="btn btn-outline-dark btn-lg w-100 py-3 rounded-3 shadow-sm">
                                        <i class="bi bi-cart-plus me-1"></i> Adicionar ao carrinho
                                    </button>
                                </div>
                            </div>
                        </form>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <a asp-controller="Order"
                                   asp-action="BuyNow"
                                   asp-route-id="@Model.Id"
                                   asp-route-quantity="1"
                                   id="buyNowLink"
                                   class="btn btn-artisan w-100 py-3 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-bag-check"></i>
                                    Comprar pelo site
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a asp-controller="Home"
                                   asp-action="ContactSeller"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-success w-100 py-3 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-whatsapp"></i>
                                    Comprar pelo WhatsApp
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border rounded-3 mb-3">
                            <div class="d-flex gap-2 align-items-start">
                                <i class="bi bi-person-lock text-gold fs-5"></i>
                                <div>
                                    <strong>Cadastro necessário para comprar</strong>
                                    <p class="small text-muted mb-0 mt-1">
                                        Crie sua conta para comprar pelo site ou entrar em contato com o vendedor.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <a asp-controller="Account"
                                   asp-action="Register"
                                   asp-route-returnUrl="@Url.Action("BuyNow", "Order", new { id = Model.Id, quantity = 1 })"
                                   class="btn btn-artisan w-100 py-3 rounded-3 shadow-sm">
                                    <i class="bi bi-bag-check me-1"></i>
                                    Criar conta e comprar
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a asp-controller="Account"
                                   asp-action="Register"
                                   asp-route-returnUrl="@Url.Action("ContactSeller", "Home", new { id = Model.Id })"
                                   class="btn btn-success w-100 py-3 rounded-3 shadow-sm">
                                    <i class="bi bi-whatsapp me-1"></i>
                                    Criar conta e falar
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <button class="btn btn-secondary btn-lg w-100 py-3 rounded-3" disabled>
                        <i class="bi bi-slash-circle me-2"></i> Peça Indisponível
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const quantity = document.getElementById("quantity");
            const buyNowLink = document.getElementById("buyNowLink");

            if (!quantity || !buyNowLink) return;

            quantity.addEventListener("input", function () {
                const value = Math.max(1, Number(quantity.value || 1));
                const url = new URL(buyNowLink.href, window.location.origin);
                url.searchParams.set("quantity", value);
                buyNowLink.href = url.pathname + url.search;
            });
        });
    </script>
}
