@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const quantityInput =
                    document.getElementById(
                        "quantity"
                    );

                const buyNowQuantity =
                    document.getElementById(
                        "buyNowQuantity"
                    );

                const decreaseButton =
                    document.getElementById(
                        "decreaseQuantity"
                    );

                const increaseButton =
                    document.getElementById(
                        "increaseQuantity"
                    );


                function syncQuantity() {

                    if (!quantityInput)
                        return;


                    let value =
                        parseInt(
                            quantityInput.value || "1"
                        );


                    const min =
                        parseInt(
                            quantityInput.min || "1"
                        );


                    const max =
                        parseInt(
                            quantityInput.max || "999999"
                        );


                    if (value < min)
                        value = min;


                    if (value > max)
                        value = max;


                    quantityInput.value =
                        value;


                    if (buyNowQuantity) {

                        buyNowQuantity.value =
                            value;

                    }

                }


                quantityInput?.addEventListener(
                    "input",
                    syncQuantity
                );


                decreaseButton?.addEventListener(
                    "click",
                    function () {

                        if (!quantityInput)
                            return;


                        const current =
                            parseInt(
                                quantityInput.value || "1"
                            );


                        const min =
                            parseInt(
                                quantityInput.min || "1"
                            );


                        quantityInput.value =
                            Math.max(
                                min,
                                current - 1
                            );


                        syncQuantity();

                    }
                );


                increaseButton?.addEventListener(
                    "click",
                    function () {

                        if (!quantityInput)
                            return;


                        const current =
                            parseInt(
                                quantityInput.value || "1"
                            );


                        const max =
                            parseInt(
                                quantityInput.max || "999999"
                            );


                        quantityInput.value =
                            Math.min(
                                max,
                                current + 1
                            );


                        syncQuantity();

                    }
                );


                syncQuantity();

            }
        );

    </script>

}