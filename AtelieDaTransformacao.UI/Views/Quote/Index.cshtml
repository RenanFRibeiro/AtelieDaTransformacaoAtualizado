@model AtelieDaTransformacao.UI.Models.QuoteRequestViewModel
@{ ViewData["Title"] = "Solicitar orçamento"; }
<section class="page-hero text-center py-5 mb-4"><div class="container"><span class="eyebrow">PROJETO PERSONALIZADO</span><h1 class="display-5 serif-title fw-bold mt-2">Conte sua ideia. Nós ajudamos a transformá-la.</h1><p class="text-muted lead">Preencha os detalhes e o pedido será preparado para continuar pelo WhatsApp.</p></div></section>
<div class="container pb-5"><div class="row justify-content-center"><div class="col-lg-9"><div class="quote-card p-4 p-md-5"><form asp-action="Index" method="post" class="row g-4"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-6"><label asp-for="Name" class="form-label fw-semibold">Seu nome</label><input asp-for="Name" class="form-control form-control-lg" placeholder="Como podemos chamar você?"/><span asp-validation-for="Name" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Phone" class="form-label fw-semibold">WhatsApp</label><input asp-for="Phone" class="form-control form-control-lg" placeholder="(11) 99999-9999"/><span asp-validation-for="Phone" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="ProductType" class="form-label fw-semibold">Que peça você deseja?</label><input asp-for="ProductType" class="form-control form-control-lg" placeholder="Ex.: mesa, decoração, móvel"/><span asp-validation-for="ProductType" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Measurements" class="form-label fw-semibold">Medidas aproximadas</label><input asp-for="Measurements" class="form-control form-control-lg" placeholder="Ex.: 2m x 1m"/></div><div class="col-12"><label asp-for="Material" class="form-label fw-semibold">Material ou estilo desejado</label><input asp-for="Material" class="form-control form-control-lg" placeholder="Madeira, rústico, moderno..."/></div><div class="col-12"><label asp-for="Description" class="form-label fw-semibold">Conte mais sobre seu projeto</label><textarea asp-for="Description" rows="6" class="form-control" placeholder="Descreva sua ideia, ambiente e detalhes importantes."></textarea><span asp-validation-for="Description" class="text-danger small"></span></div><div class="col-12"><button class="btn btn-artisan btn-lg rounded-pill px-5"><i class="bi bi-whatsapp me-2"></i>Continuar orçamento no WhatsApp</button></div></form></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
