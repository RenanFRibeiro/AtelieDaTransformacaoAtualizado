@model AtelieDaTransformacao.Application.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Finalizar compra";
}

<div class="container py-5">
    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <div class="mb-4">
                <span class="text-uppercase text-gold fw-bold small">Compra segura e personalizada</span>
                <h1 class="serif-title fw-bold mb-2">Finalizar compra</h1>
                <p class="text-muted mb-0">Seus dados foram preenchidos automaticamente a partir do seu cadastro. Revise antes de confirmar.</p>
            </div>

            <form asp-action="Checkout" method="post" id="checkoutForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DirectProductId" />
                <input type="hidden" asp-for="DirectQuantity" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4"></div>

                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4 p-lg-5">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <span class="small text-muted">01</span>
                                <h4 class="serif-title fw-bold mb-1">Seus dados</h4>
                                <p class="small text-muted mb-0">Você pode corrigir qualquer informação antes de confirmar.</p>
                            </div>
                            <i class="bi bi-person-check fs-2 text-gold"></i>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CustomerName" class="form-label fw-semibold"></label>
                                <input asp-for="CustomerName" class="form-control form-control-lg rounded-3" autocomplete="name" />
                                <span asp-validation-for="CustomerName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">E-mail</label>
                                <div class="checkout-email-display">@Model.CustomerEmail</div>
                                <input type="hidden" asp-for="CustomerEmail" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CustomerPhone" class="form-label fw-semibold"></label>
                                <input asp-for="CustomerPhone" class="form-control form-control-lg rounded-3" autocomplete="tel" inputmode="tel" maxlength="15" placeholder="(11) 99999-9999" />
                                <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4 p-lg-5">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <span class="small text-muted">02</span>
                                <h4 class="serif-title fw-bold mb-1">Entrega</h4>
                                <p class="small text-muted mb-0">O endereço abaixo veio do seu cadastro.</p>
                            </div>
                            <i class="bi bi-truck fs-2 text-gold"></i>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="DeliveryMethod" class="form-label fw-semibold"></label>
                                <select asp-for="DeliveryMethod" class="form-select form-select-lg rounded-3" id="deliveryMethod">
                                    <option value="Entrega">Entrega</option>
                                    <option value="Retirada no ateliê">Retirada no ateliê</option>
                                </select>
                                <span asp-validation-for="DeliveryMethod" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PostalCode" class="form-label fw-semibold"></label>
                                <input asp-for="PostalCode" class="form-control form-control-lg rounded-3" autocomplete="postal-code" />
                                <span asp-validation-for="PostalCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="ShippingAddress" class="form-label fw-semibold"></label>
                                <input asp-for="ShippingAddress" class="form-control form-control-lg rounded-3" autocomplete="street-address" />
                                <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AddressNumber" class="form-label fw-semibold"></label>
                                <input asp-for="AddressNumber" class="form-control form-control-lg rounded-3" autocomplete="address-line2" />
                                <span asp-validation-for="AddressNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Complement" class="form-label fw-semibold"></label>
                                <input asp-for="Complement" class="form-control form-control-lg rounded-3" autocomplete="address-line2" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="District" class="form-label fw-semibold"></label>
                                <input asp-for="District" class="form-control form-control-lg rounded-3" autocomplete="address-level3" />
                                <span asp-validation-for="District" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="City" class="form-label fw-semibold"></label>
                                <input asp-for="City" class="form-control form-control-lg rounded-3" autocomplete="address-level2" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                            <div class="col-md-2">
                                <label asp-for="State" class="form-label fw-semibold"></label>
                                <input asp-for="State" maxlength="2" class="form-control form-control-lg rounded-3 text-uppercase" autocomplete="address-level1" />
                                <span asp-validation-for="State" class="text-danger small"></span>
                            </div>
                            
                            <!-- Nova área interativa de seleções de frete -->
                            <div class="col-12 mt-4" id="freightOptionsContainer" style="display: none;">
                                <label class="form-label fw-semibold">Opções de Frete Disponíveis</label>
                                <div class="row g-2" id="freightOptionsList"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4 p-lg-5">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <span class="small text-muted">03</span>
                                <h4 class="serif-title fw-bold mb-1">Pagamento</h4>
                                <p class="small text-muted mb-0">Escolha a opção que deseja combinar com o vendedor.</p>
                            </div>
                            <i class="bi bi-wallet2 fs-2 text-gold"></i>
                        </div>

                        <div class="row g-3">
                            @foreach (var method in new[] { "Pix", "Cartão de crédito", "Cartão de débito", "Transferência bancária", "A combinar" })
                            {
                                var id = "payment_" + method.Replace(" ", "_").Replace("ã", "a").Replace("é", "e").Replace("á", "a");
                                <div class="col-md-6">
                                    <label class="payment-option border rounded-4 p-3 d-flex gap-3 align-items-center h-100">
                                        <input class="form-check-input mt-0" type="radio" asp-for="PaymentMethod" value="@method" />
                                        <span>
                                            <strong class="d-block">@method</strong>
                                            <small class="text-muted">Forma registrada no pedido</small>
                                        </span>
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>

                        <div class="alert alert-warning rounded-4 mt-4 mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            O site registra a forma de pagamento escolhida, mas o processamento financeiro ainda é confirmado com o vendedor. Nenhum cartão é cobrado nesta etapa.
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4 p-lg-5">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <span class="small text-muted">04</span>
                                <h4 class="serif-title fw-bold mb-1">Observações</h4>
                            </div>
                            <i class="bi bi-chat-left-text fs-2 text-gold"></i>
                        </div>
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control rounded-4" rows="4" placeholder="Alguma instrução para entrega, retirada ou atendimento?"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex flex-column flex-md-row gap-2 justify-content-end">
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 py-3">Voltar ao carrinho</a>
                    <button type="submit" class="btn btn-artisan rounded-pill px-5 py-3 fw-semibold" id="confirmCheckoutButton">
                        <i class="bi bi-check2-circle me-2"></i> Confirmar compra
                    </button>
                </div>
            </form>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-lg-top" style="top:100px;">
                <div class="card-body p-4">
                    <span class="text-uppercase text-gold fw-bold small">Resumo</span>
                    <h3 class="serif-title fw-bold mb-4">Seu pedido</h3>

                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex gap-3 align-items-center mb-3">
                            <img src="@(string.IsNullOrWhiteSpace(item.Image) ? "/images/placeholder.jpg" : item.Image)" alt="@item.Title" class="rounded-3" style="width:58px;height:58px;object-fit:cover;" />
                            <div class="flex-grow-1">
                                <strong class="d-block">@item.Title</strong>
                                <small class="text-muted">@item.Quantity x R$ @item.UnitPrice.ToString("N2")</small>
                            </div>
                            <strong>R$ @item.Subtotal.ToString("N2")</strong>
                        </div>
                    }

                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Itens</span>
                        <strong>@Model.Items.Sum(x => x.Quantity)</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3" id="shippingCostRow">
                        <span class="text-muted">
                            Frete 
                            <small id="shippingEstimateDisplay" class="text-success d-block"></small>
                        </span>
                        <strong id="shippingCostDisplay">R$ @Model.ShippingCost.ToString("N2")</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Total</span>
                        <span class="fs-4 fw-bold" id="totalDisplay" data-subtotal="@Model.Subtotal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">R$ @Model.Total.ToString("N2")</span>
                    </div>

                    <input type="hidden" asp-for="ShippingCost" id="hiddenShippingCost" />
                    <input type="hidden" asp-for="ShippingEstimateDays" id="hiddenShippingEstimateDays" />

                    <div class="alert alert-light border rounded-4 mt-4 mb-0">
                        <i class="bi bi-shield-check text-gold me-2"></i>
                        <small>Depois da confirmação, seu pedido receberá um número e você poderá acompanhar o status pelo site.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .checkout-email-display {
        min-height: 48px;
        display: flex;
        align-items: center;
        color: #1f1f1f;
        font-size: 1.1rem;
        line-height: 1.5;
        word-break: break-word;
    }

    .payment-option, .freight-option { cursor: pointer; transition: .2s ease; background: #fff; }
    .payment-option:hover, .freight-option:hover { transform: translateY(-1px); box-shadow: 0 .35rem 1rem rgba(0,0,0,.06); }
    .payment-option:has(input:checked), .freight-option:has(input:checked) { border-color: var(--artisan-clay,#b85a3a) !important; box-shadow: 0 0 0 2px rgba(184,90,58,.12); }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('checkoutForm')?.addEventListener('submit', function () {
            const button = document.getElementById('confirmCheckoutButton');
            if (!button) return;
            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Criando pedido...';
        });

        const phoneInput = document.querySelector('input[name="CustomerPhone"]');

        function formatPhone(value) {
            const digits = value.replace(/\D/g, '').slice(0, 11);
            if (digits.length <= 10) {
                return digits.replace(/(\d{2})(\d{4})(\d{0,4})/, '($1) $2-$3').replace(/-$/, '');
            }
            return digits.replace(/(\d{2})(\d{5})(\d{0,4})/, '($1) $2-$3').replace(/-$/, '');
        }

        phoneInput?.addEventListener('input', function () { this.value = formatPhone(this.value); });
        if (phoneInput?.value) { phoneInput.value = formatPhone(phoneInput.value); }

        const delivery = document.getElementById('deliveryMethod');
        const addressFields = ['PostalCode','ShippingAddress','AddressNumber','District','City','State'];

        const cepInput = document.getElementById('PostalCode');
        const hiddenShippingCost = document.getElementById('hiddenShippingCost');
        const hiddenShippingEstimateDays = document.getElementById('hiddenShippingEstimateDays');
        const shippingCostDisplay = document.getElementById('shippingCostDisplay');
        const shippingEstimateDisplay = document.getElementById('shippingEstimateDisplay');
        const totalDisplay = document.getElementById('totalDisplay');
        
        function updateOrderTotal(shippingCost) {
            const subtotal = parseFloat(totalDisplay.getAttribute('data-subtotal')) || 0;
            const total = subtotal + shippingCost;
            
            const formatter = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
            
            shippingCostDisplay.textContent = shippingCost === 0 ? 'Grátis' : formatter.format(shippingCost);
            totalDisplay.textContent = formatter.format(total);
            hiddenShippingCost.value = shippingCost.toFixed(2).replace('.', ',');
        }

        window.selectFreight = function(radioElement) {
            const valor = parseFloat(radioElement.value);
            const days = radioElement.getAttribute('data-days');
            const name = radioElement.getAttribute('data-name');
            
            shippingEstimateDisplay.className = "text-success d-block";
            shippingEstimateDisplay.textContent = `Via ${name} (${days} dias úteis)`;
            hiddenShippingEstimateDays.value = days;
            updateOrderTotal(valor);
        }

        async function fetchEnderecoAndFrete() {
            const cep = cepInput.value.replace(/\D/g, '');
            if (cep.length !== 8) return;

            const isPickup = delivery?.value === 'Retirada no ateliê';
            if (isPickup) return;

            // 1. Preencher Endereço
            try {
                const response = await fetch(`/Cep/BuscarEndereco?cep=${cep}`);
                if (response.ok) {
                    const data = await response.json();
                    if (!data.erro) {
                        document.getElementById('ShippingAddress').value = data.logradouro;
                        document.getElementById('District').value = data.bairro;
                        document.getElementById('City').value = data.cidade;
                        document.getElementById('State').value = data.estado;
                        document.getElementById('AddressNumber').focus();
                    } else {
                        alert(data.mensagem || "CEP não encontrado. Por favor, preencha manualmente.");
                    }
                }
            } catch (err) {
                console.error('Erro ao buscar CEP:', err);
            }

            // 2. Calcular Frete Dinamicamente
            try {
                shippingEstimateDisplay.textContent = "Calculando...";
                shippingEstimateDisplay.className = "text-warning d-block";
                document.getElementById('freightOptionsContainer').style.display = 'none';
                
                // Variáveis enviadas para cálculo com peso e dimensões inclusas
                const requestData = {
                    CepDestino: cep,
                    CepOrigem: "01000000",
                    PesoKg: 1.5, // Dinâmico de acordo com os produtos da loja
                    AlturaCm: 25,
                    LarguraCm: 25,
                    ComprimentoCm: 20
                };

                const responseFrete = await fetch('/Cep/CalcularFrete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(requestData)
                });
                
                if (responseFrete.ok) {
                    const opcoes = await responseFrete.json();
                    
                    if (opcoes && opcoes.length > 0 && opcoes[0].disponivel !== false) {
                        shippingEstimateDisplay.className = "text-success d-block";
                        shippingEstimateDisplay.textContent = "Selecione uma opção de frete";
                        
                        const list = document.getElementById('freightOptionsList');
                        list.innerHTML = '';
                        
                        opcoes.forEach((opcao, index) => {
                            const isChecked = index === 0 ? 'checked' : '';
                            const formatter = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
                            
                            const div = document.createElement('div');
                            div.className = 'col-md-6';
                            div.innerHTML = `
                                <label class="freight-option border rounded-4 p-3 d-flex gap-3 align-items-center h-100">
                                    <input class="form-check-input mt-0" type="radio" name="SelectedFreight" value="${opcao.valor}" data-days="${opcao.prazoEstimadoDias}" data-name="${opcao.nome}" ${isChecked} onchange="selectFreight(this)">
                                    <span>
                                        <strong class="d-block">${opcao.nome} - ${formatter.format(opcao.valor)}</strong>
                                        <small class="text-muted">${opcao.descricao} (Aprox. ${opcao.prazoEstimadoDias} dias)</small>
                                    </span>
                                </label>
                            `;
                            list.appendChild(div);
                        });
                        
                        document.getElementById('freightOptionsContainer').style.display = 'block';
                        selectFreight(list.querySelector('input[type="radio"]')); // Seleciona automaticamente o primeiro (PAC)
                    } else {
                        shippingEstimateDisplay.className = "text-danger d-block";
                        shippingEstimateDisplay.textContent = opcoes[0]?.descricao || "Indisponível para esta região.";
                        updateOrderTotal(0);
                    }
                } else {
                    shippingEstimateDisplay.className = "text-danger d-block";
                    shippingEstimateDisplay.textContent = "Erro de conexão (Cód: " + responseFrete.status + ")";
                    updateOrderTotal(0);
                }
            } catch (err) {
                console.error('Erro ao calcular frete:', err);
                shippingEstimateDisplay.className = "text-danger d-block";
                shippingEstimateDisplay.textContent = "Erro ao calcular o frete.";
                updateOrderTotal(0);
            }
        }

        function syncDeliveryFields() {
            const pickup = delivery?.value === 'Retirada no ateliê';
            addressFields.forEach(name => {
                const el = document.getElementById(name);
                if (!el) return;
                el.disabled = pickup;
                el.closest('.col-md-4, .col-md-8, .col-md-2')?.classList.toggle('opacity-50', pickup);
            });
            
            if (pickup) {
                document.getElementById('freightOptionsContainer').style.display = 'none';
                shippingEstimateDisplay.className = "text-success d-block";
                shippingEstimateDisplay.textContent = "Retirada grátis na loja";
                updateOrderTotal(0);
            } else if (cepInput.value.replace(/\D/g, '').length === 8) {
                fetchEnderecoAndFrete();
            } else {
                shippingEstimateDisplay.textContent = "";
                document.getElementById('freightOptionsContainer').style.display = 'none';
                updateOrderTotal(0);
            }
        }

        cepInput?.addEventListener('blur', fetchEnderecoAndFrete);
        delivery?.addEventListener('change', syncDeliveryFields);
        syncDeliveryFields();
    </script>
}