@model IReadOnlyList<AtelieDaTransformacao.Application.DTOs.OrderListDto>
@using AtelieDaTransformacao.Domain.Enums
@using System.Text.Json
@{
    ViewData["Title"] = "Histórico de pedidos";
    var selectedStatus = ViewBag.Status as OrderStatus?;
    var keyword = ViewBag.Keyword as string ?? "";
    var startDate = ViewBag.StartDate as string ?? "";
    var endDate = ViewBag.EndDate as string ?? "";
}
<div class="container py-4 py-lg-5 order-page">
    <div class="order-history-head">
        <div>
            <span class="order-eyebrow">SEU HISTÓRICO</span>
            <h1 class="serif-title order-page-title mb-1">Pedidos concluídos</h1>
            <p class="text-muted mb-0">Envios, entregas e cancelamentos ficam organizados aqui.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-dark rounded-pill px-4"><i class="bi bi-arrow-left me-1"></i> Pedidos ativos</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 order-history-filter-card">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="History" class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small text-muted">Status</label>
                    <select class="form-select" name="status">
                        <option value="">Todos</option>
                        <option value="Enviado" selected="@(selectedStatus == OrderStatus.Enviado)">Enviado</option>
                        <option value="Entregue" selected="@(selectedStatus == OrderStatus.Entregue)">Entregue</option>
                        <option value="Cancelado" selected="@(selectedStatus == OrderStatus.Cancelado)">Cancelado</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small text-muted">Buscar</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                        <input class="form-control border-start-0" name="keyword" value="@keyword" placeholder="Pedido ou palavra-chave" />
                    </div>
                </div>
                <div class="col-6 col-md-2"><label class="form-label small text-muted">De</label><input class="form-control" type="date" name="startDate" value="@startDate" /></div>
                <div class="col-6 col-md-2"><label class="form-label small text-muted">Até</label><input class="form-control" type="date" name="endDate" value="@endDate" /></div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button class="btn btn-artisan rounded-pill flex-grow-1" type="submit"><i class="bi bi-funnel me-1"></i> Filtrar</button>
                    <a asp-action="History" class="btn btn-outline-secondary rounded-pill" title="Limpar filtros"><i class="bi bi-x-lg"></i></a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 order-empty-card">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="order-empty-icon"><i class="bi bi-clock-history"></i></div>
                <h2 class="serif-title fw-bold mt-3">Nenhum pedido no histórico</h2>
                <p class="text-muted mb-0">Quando um pedido for enviado, entregue ou cancelado, ele aparecerá aqui automaticamente.</p>
            </div>
        </div>
    }
    else
    {
        <div class="order-history-list">
        @foreach (var order in Model)
        {
            var tone = order.Status == OrderStatus.Cancelado ? "danger" : order.Status == OrderStatus.Entregue ? "success" : "neutral";
            var action = order.Status == OrderStatus.Cancelado ? "Pedido cancelado" : order.Status == OrderStatus.Entregue ? "Pedido entregue" : "Pedido enviado";
            <article class="card border-0 shadow-sm rounded-4 order-history-card" data-history-order="@order.Id">
                <div class="card-body p-3 p-md-4">
                    <div class="order-history-grid">
                        <div>
                            <span class="order-label">Pedido</span>
                            <strong class="order-number d-block">@order.OrderNumber</strong>
                            <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div><span class="order-label">Status final</span><span class="order-history-status @tone"><i class="bi @(order.Status == OrderStatus.Cancelado ? "bi-x-circle" : order.Status == OrderStatus.Entregue ? "bi-check-circle" : "bi-send")"></i>@order.StatusName</span></div>
                        <div><span class="order-label">Data da conclusão</span><strong>@order.StatusChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
                        <div><span class="order-label">Ação registrada</span><span class="text-muted small"><i class="bi bi-check2 me-1"></i>@action</span></div>
                        <div class="order-history-total"><span class="order-label">Total</span><strong>R$ @order.Total.ToString("N2")</strong></div>
                        <div class="order-history-action"><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-dark rounded-pill px-3"><i class="bi bi-eye me-1"></i> Detalhes</a></div>
                    </div>
                </div>
            </article>
        }
        </div>
    }
</div>

@section Scripts {
<script>
(() => {
    if (typeof signalR === 'undefined') return;
    const connection = new signalR.HubConnectionBuilder().withUrl('/hubs/orders').withAutomaticReconnect().build();
    connection.on('StatusUpdated', data => {
        if ([5,6,7].includes(Number(data.status))) {
            // O histórico pode estar aberto em outra aba; recarrega apenas quando há uma mudança relevante.
            window.location.reload();
        }
    });
    connection.start().catch(() => {});
})();
</script>
}
