@model IReadOnlyList<AtelieDaTransformacao.Application.DTOs.OrderListDto>

@using AtelieDaTransformacao.Domain.Enums

@{
    ViewData["Title"] = "Meus Pedidos";
}

<div class="container py-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>

            <span class="text-uppercase text-gold fw-bold small">
                Acompanhamento
            </span>

            <h1 class="serif-title fw-bold mb-1">
                Meus pedidos
            </h1>

            <p class="text-muted mb-0">
                Acompanhe cada etapa do seu pedido sem sair do site.
            </p>

        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-dark rounded-pill px-4">

            <i class="bi bi-arrow-left me-1"></i>

            Voltar para a coleção

        </a>

        <a asp-action="History" class="btn btn-light rounded-pill px-4 order-history-button">
            <i class="bi bi-clock-history me-1"></i> Histórico
        </a>

    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success rounded-4 shadow-sm">

            <i class="bi bi-check-circle me-2"></i>

            @success

        </div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger rounded-4 shadow-sm">

            <i class="bi bi-exclamation-circle me-2"></i>

            @error

        </div>
    }

    @if (Model == null ||
         Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">

            <i class="bi bi-box-seam display-3 text-gold"></i>

            <h2 class="serif-title fw-bold mt-3">
                Você ainda não possui pedidos
            </h2>

            <p class="text-muted">
                Adicione uma peça ao carrinho e escolha
                <strong>"Comprar pelo site"</strong>.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-artisan rounded-pill px-4">

                <i class="bi bi-bag me-1"></i>

                Ver coleção

            </a>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var order in Model)
            {
                var canCancel =
                    order.Status.CanCancel();

                <div class="col-12">

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden"
                         data-order-card="@order.Id">

                        <div class="card-body p-4">

                            <div class="row align-items-center g-4">

                                <div class="col-lg-3">

                                    <span class="small text-muted d-block">
                                        Pedido
                                    </span>

                                    <strong class="fs-5">
                                        @order.OrderNumber
                                    </strong>

                                    <small class="text-muted d-block mt-1">

                                        <i class="bi bi-calendar3 me-1"></i>

                                        @(order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))

                                    </small>

                                </div>

                                <div class="col-lg-2">

                                    <span class="small text-muted d-block">
                                        Total
                                    </span>

                                    <strong class="fs-5">
                                        R$ @order.Total.ToString("N2")
                                    </strong>

                                </div>

                                <div class="col-lg-2">

                                    <span class="small text-muted d-block mb-1">
                                        Status
                                    </span>

                                    @if (order.Status ==
                                         OrderStatus.Cancelado)
                                    {
                                        <span class="badge rounded-pill px-3 py-2 bg-danger"
                                              data-order-status="@order.Id">

                                            <i class="bi bi-x-circle me-1"></i>

                                            Cancelado

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-3 py-2 bg-dark"
                                              data-order-status="@order.Id">

                                            @order.StatusName

                                        </span>
                                    }

                                    @if (order.AutoAdvance &&
                                         order.Status !=
                                         OrderStatus.Cancelado)
                                    {
                                        <small class="text-success d-block mt-1">

                                            <i class="bi bi-arrow-repeat me-1"></i>

                                            Atualização automática

                                        </small>
                                    }

                                </div>

                                <div class="col-lg-5">

                                    <div class="d-flex flex-wrap justify-content-lg-end gap-2">

                                        <a asp-controller="Order"
                                           asp-action="Details"
                                           asp-route-id="@order.Id"
                                           class="btn btn-artisan rounded-pill px-4">

                                            <i class="bi bi-eye me-1"></i>

                                            Acompanhar pedido

                                        </a>

                                        @if (canCancel)
                                        {
                                            <form asp-controller="Order"
                                                  asp-action="Cancel"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Tem certeza que deseja cancelar este pedido? O estoque reservado será devolvido.');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@order.Id" />

                                                <button type="submit"
                                                        class="btn btn-outline-danger rounded-pill px-4">

                                                    <i class="bi bi-x-circle me-1"></i>

                                                    Cancelar pedido

                                                </button>

                                            </form>
                                        }
                                        else if (
                                            order.Status ==
                                            OrderStatus.Cancelado)
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2 d-flex align-items-center">

                                                <i class="bi bi-x-circle me-1"></i>

                                                Pedido cancelado

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border rounded-pill px-3 py-2 d-flex align-items-center">

                                                <i class="bi bi-lock me-1"></i>

                                                Cancelamento indisponível

                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>

                            @if (canCancel)
                            {
                                <div class="border-top mt-4 pt-3">

                                    <div class="small text-muted">

                                        <i class="bi bi-info-circle me-1"></i>

                                        Você pode cancelar este pedido enquanto
                                        ele não estiver
                                        <strong>enviado</strong> ou
                                        <strong>entregue</strong>.

                                    </div>

                                </div>
                            }
                            else if (
                                order.Status ==
                                OrderStatus.Cancelado)
                            {
                                <div class="border-top mt-4 pt-3">

                                    <div class="small text-danger">

                                        <i class="bi bi-x-circle me-1"></i>

                                        Este pedido foi cancelado e não poderá
                                        avançar para as próximas etapas.

                                    </div>

                                </div>
                            }

                        </div>

                        @if (order.Status ==
                             OrderStatus.Entregue)
                        {
                            @await Component.InvokeAsync(
                                "Feedbacks",
                                new
                                {
                                    orderId = order.Id
                                })
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>

<style>
    /* ===== Avaliações dos produtos ===== */
    .order-feedback-area {
        margin-top: 0 !important;
        padding: 26px 24px 28px !important;
        border-top: 1px solid rgba(0, 0, 0, .08);
        background: #fff;
    }

    .order-feedback-area > .text-uppercase,
    .order-feedback-area .text-uppercase {
        display: block;
        margin-bottom: 4px;
        font-size: .72rem;
        letter-spacing: .04em;
    }

    .order-feedback-area h4,
    .order-feedback-area h5,
    .order-feedback-area h6 {
        margin-top: 0;
        margin-bottom: 14px;
        line-height: 1.2;
    }

    .feedback-order-card {
        width: 100% !important;
        max-width: none !important;
        margin: 0 0 12px 0 !important;
        padding: 18px 20px !important;
        border: 1px solid rgba(0, 0, 0, .09) !important;
        border-radius: 16px !important;
        background: #fbfaf8 !important;
        box-shadow: none !important;
        box-sizing: border-box;
    }

    .feedback-order-card:last-child {
        margin-bottom: 0 !important;
    }

    .feedback-order-card .small {
        line-height: 1.45;
    }

    .feedback-order-card .fw-bold {
        color: #241812;
    }

    .feedback-order-card .badge {
        flex-shrink: 0;
        white-space: nowrap;
    }

    .feedback-order-card .btn {
        margin-top: 8px;
    }

    .feedback-inline-stars {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        color: #d39b42;
        letter-spacing: 0;
        line-height: 1;
    }

    .feedback-inline-image {
        display: block;
        width: min(100%, 280px);
        max-height: 220px;
        object-fit: cover;
        border-radius: 14px;
        margin-top: 12px;
    }

    /* Data da avaliação: nunca deixa o texto quebrar */
    .feedback-order-card .text-muted {
        overflow-wrap: break-word;
    }

    /* ===== Responsividade ===== */
    @@media (max-width: 767.98px) {
        .order-feedback-area {
            padding: 22px 16px 24px !important;
        }

        .feedback-order-card {
            padding: 16px !important;
            border-radius: 14px !important;
        }

        .feedback-order-card .d-flex {
            align-items: flex-start !important;
        }

        .feedback-order-card .btn {
            width: 100%;
        }
    }
</style>

@section Scripts
{
<script>
(function () {
    const terminalStatuses = new Set([5, 6, 7]);

    function removeOrderCard(orderId) {
        const card = document.querySelector(`[data-order-card="${orderId}"]`);
        if (!card) return;
        card.style.transition = 'opacity .24s ease, transform .24s ease, max-height .3s ease, margin .3s ease';
        card.style.opacity = '0';
        card.style.transform = 'translateY(-6px)';
        card.style.maxHeight = `${card.offsetHeight}px`;
        requestAnimationFrame(() => {
            card.style.maxHeight = '0';
            card.style.marginBottom = '0';
        });
        setTimeout(() => {
            card.remove();
            if (!document.querySelector('[data-order-card]')) window.location.reload();
        }, 330);
    }

    function applyOrderStatus(data) {
        const status = Number(data.status);
        if (terminalStatuses.has(status)) {
            removeOrderCard(data.orderId);
            return;
        }
        const badge = document.querySelector(`[data-order-status="${data.orderId}"]`);
        if (!badge) return;
        badge.className = 'badge rounded-pill px-3 py-2 bg-dark order-status';
        badge.textContent = data.statusName || '';
    }

    async function refreshOrder(orderId) {
        try {
            const response = await fetch(`/Order/Status/${orderId}`, { cache: 'no-store' });
            if (!response.ok) return;
            applyOrderStatus(await response.json());
        } catch (_) { }
    }

    document.addEventListener('DOMContentLoaded', async () => {
        document.querySelectorAll('[data-order-card]').forEach(card => refreshOrder(card.dataset.orderCard));

        if (typeof signalR !== 'undefined') {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/orders')
                .withAutomaticReconnect()
                .build();
            connection.on('StatusUpdated', applyOrderStatus);
            connection.start().catch(() => {});
        }

        setInterval(() => {
            document.querySelectorAll('[data-order-card]').forEach(card => refreshOrder(card.dataset.orderCard));
        }, 10000);
    });
})();
</script>
}