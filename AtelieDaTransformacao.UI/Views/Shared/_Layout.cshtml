<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ateliê da Transformação</title>
    <meta name="description" content="Peças artesanais, móveis e projetos personalizados em madeira e resina. Conheça o Ateliê da Transformação." />
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


</head>
<body class="d-flex flex-column min-vh-100" style="--artisan-gold: #dfb76c; --artisan-clay: #b85a3a; --artisan-wood: #1a1512;">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-artisan-dark navbar-artisan py-3 shadow-sm sticky-top">
            <div class="container">
                <!-- Marca (esquerda) -->
                <a class="navbar-brand d-flex align-items-center fw-bold fs-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-tree-fill text-gold me-2 fs-3" aria-hidden="true"></i>
                    <span class="serif-title">Ateliê da <span class="text-gold ms-2">Transformação</span></span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Alternar menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <!-- Menu central -->
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item"><a class="nav-link nav-link-artisan px-3" asp-controller="Home" asp-action="Index">Coleção</a></li>
                        <li class="nav-item"><a class="nav-link nav-link-artisan px-3" asp-controller="Home" asp-action="Gallery">Projetos</a></li>
                        <li class="nav-item"><a class="nav-link nav-link-artisan px-3" asp-controller="Home" asp-action="About">Sobre</a></li>
                    </ul>

                    <!-- Ações (direita) -->
                    <div class="d-flex align-items-center gap-2 ms-auto ms-lg-3 header-actions">
                        <a class="btn btn-artisan btn-sm action-btn d-inline-flex align-items-center" asp-controller="Quote" asp-action="Index">
                            <i class="bi bi-pencil-square me-2"></i> Solicitar orçamento
                        </a>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var firstName = User.FindFirst(ClaimTypes.GivenName)?.Value;

                            if (!string.IsNullOrWhiteSpace(firstName))
                            {
                                <span class="small text-white-50 d-none d-xl-inline">Olá, @firstName</span>
                            }

                            if (User.IsInRole("Admin"))
                            {
                                <a class="btn btn-outline-artisan btn-sm action-btn d-inline-flex align-items-center" asp-controller="Admin" asp-action="Index" title="Painel do Artesão">
                                    <i class="bi bi-sliders me-1"></i> Painel
                                </a>
                            }

                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-ghost text-white-50 small px-3 py-2">
                                    <i class="bi bi-box-arrow-right me-1"></i> Sair
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-ghost text-white-50 small px-3 py-2" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
                            </a>
                            <a class="btn btn-outline-artisan btn-sm action-btn d-inline-flex align-items-center" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i> Criar Conta
                            </a>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="btn btn-outline-artisan btn-sm action-btn d-inline-flex align-items-center position-relative" asp-controller="Order" asp-action="Index" title="Meus pedidos">
                                <i class="bi bi-box-seam me-2"></i> Meus pedidos
                            </a>

                            <a class="btn btn-outline-artisan btn-sm action-btn d-inline-flex align-items-center position-relative" asp-controller="Cart" asp-action="Index" title="Ver carrinho">
                                <i class="bi bi-cart3 me-2"></i> Carrinho
                                <span class="badge bg-danger ms-2" id="cartCountBadge" style="display:none;">0</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index")
    {
        @await Component.InvokeAsync("Carousel")
        <div id="galeria-ancora"></div>
    }

    <main role="main" class="flex-grow-1 container my-2">
        @RenderBody()
    </main>

    <section class="py-5 bg-white border-top border-bottom border-light shadow-sm">
        <div class="container">
            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <div class="p-3">
                        <i class="bi bi-shield-check text-gold fs-1 mb-3 d-block"></i>
                        <h5 class="fw-bold text-dark">Garantia Origem</h5>
                        <p class="text-muted small mb-0">Madeiras nobres certificadas, rastreáveis e extraídas em total conformidade socioambient.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3">
                        <i class="bi bi-droplet-half text-gold fs-1 mb-3 d-block"></i>
                        <h5 class="fw-bold text-dark">Resina Premium</h5>
                        <p class="text-muted small mb-0">Proteção UV total que evita o amarelecimento, oferecendo acabamento vitrificado cristalino.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3">
                        <i class="bi bi-whatsapp text-gold fs-1 mb-3 d-block"></i>
                        <h5 class="fw-bold text-dark">Atendimento Direto</h5>
                        <p class="text-muted small mb-0">Sem intermediários. Negocie diretamente com o mestre artesão responsável pela sua obra.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer class="bg-artisan-dark text-white-50 py-5">
        <div class="container text-center">
            <h4 class="text-white mb-2">Ateliê da Transformação</h4>
            <p class="small opacity-50 mb-4 mx-auto" style="max-width: 500px;">
                Mobiliário Orgânico de Luxo, Arte Rústica Funcional e Design Customizado sob Medida.
            </p>
            <div class="border-top border-secondary border-opacity-10 pt-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <small class="small opacity-75">&copy; @System.DateTime.Now.Year T1B-3 Digital Studio. Todos os direitos reservados. | Desenvolvido com 💙 pela T1B-3.</small>
                <div class="d-flex gap-3 small">
                    <a href="#" class="text-white-50 text-decoration-none opacity-75">Termos de Uso</a>
                    <span class="text-secondary opacity-25">|</span>
                    <a href="#" class="text-white-50 text-decoration-none opacity-75">Política de Privacidade</a>
                </div>
            </div>
        </div>
    </footer>

    <a href="https://wa.me/5511999999999?text=Ol%C3%A1%21%20Visitei%20o%20site%20do%20Ateli%C3%AA%20da%20Transforma%C3%A7%C3%A3o%20e%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es." class="whatsapp-float" target="_blank" title="Falar Conosco no WhatsApp">
        <i class="bi bi-whatsapp"></i>
    </a>

    <!-- usar bundle local para evitar bloqueios de CDN/CORB em dev -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Inicializa o carousel explicitamente e garante que os botões prev/next funcionem
        document.addEventListener('DOMContentLoaded', function () {
            try {
                var el = document.getElementById('artisanHeroCarousel');
                if (el && window.bootstrap && typeof window.bootstrap.Carousel === 'function') {
                    // cria/obtém a instância do carousel com opções
                    var carousel = bootstrap.Carousel.getOrCreateInstance(el, { interval: 5000, ride: 'carousel', pause: 'hover', keyboard: true, wrap: true });
                    // log para depuração: quantos slides e quais URLs estão definidos (background-image)
                    try {
                        var items = el.querySelectorAll('.carousel-item');
                        console.log('Carousel items count:', items.length);
                        items.forEach(function(it, idx) {
                            var bg = window.getComputedStyle(it.querySelector('.position-relative') || it).backgroundImage || '';
                            console.log(' slide', idx, bg ? bg : '(no background-image)');
                        });
                    } catch (e) { console.warn('Não foi possível listar slides:', e); }

                    // garante que o carousel esteja em ciclo (autoplay)
                    try { carousel.cycle(); } catch (e) { /* ignore */ }

                    // se por algum motivo o carousel não fizer wrap corretamente, forçamos retorno ao primeiro slide após o último
                    try {
                        // quando chegamos ao último slide, espera 5s antes de voltar ao início
                        el.addEventListener('slid.bs.carousel', function (ev) {
                            try {
                                var items = el.querySelectorAll('.carousel-item');
                                var lastIndex = items.length - 1;
                                if (typeof ev.to !== 'undefined' && ev.to === lastIndex) {
                                    // limpa qualquer timeout anterior
                                    if (el.dataset.startTo0Timeout) { clearTimeout(parseInt(el.dataset.startTo0Timeout)); delete el.dataset.startTo0Timeout; }
                                    // pausa o carousel e aguarda 5000ms antes de ir ao primeiro slide
                                    try { carousel.pause(); } catch (e) { }
                                    var t = setTimeout(function () {
                                        try { carousel.to(0); } catch (e) { }
                                        try { carousel.cycle(); } catch (e) { }
                                        // limpa fallback interval se existir
                                        if (el.dataset.fallbackId) { clearInterval(parseInt(el.dataset.fallbackId)); delete el.dataset.fallbackId; }
                                    }, 5000);
                                    el.dataset.startTo0Timeout = t;
                                }
                            } catch (e) { /* ignore */ }
                        });
                    } catch (e) { /* ignore */ }
                    // garante que os botões prev/next chamem os métodos da instância
                    var prev = el.querySelector('[data-bs-slide="prev"]');
                    var next = el.querySelector('[data-bs-slide="next"]');
                    if (prev) prev.addEventListener('click', function (e) { e.preventDefault(); carousel.prev(); });
                    if (next) next.addEventListener('click', function (e) { e.preventDefault(); carousel.next(); });

                    // fallback: se o bootstrap não criar um intervalo interno, usamos setInterval para avançar
                    try {
                        if (!carousel._interval) {
                            var fallbackId = setInterval(function () { try { carousel.next(); } catch (e) { /* ignore */ } }, 5000);
                            el.dataset.fallbackId = fallbackId;
                        }

                        // pause/resume no hover para o fallback
                        el.addEventListener('mouseenter', function () {
                            try { carousel.pause(); } catch (e) { }
                            if (el.dataset.fallbackId) { clearInterval(parseInt(el.dataset.fallbackId)); delete el.dataset.fallbackId; }
                        });
                        el.addEventListener('mouseleave', function () {
                            try { carousel.cycle(); } catch (e) { }
                            if (!el.dataset.fallbackId && (!carousel._interval)) {
                                var id = setInterval(function () { try { carousel.next(); } catch (e) { } }, 5000);
                                el.dataset.fallbackId = id;
                            }
                        });
                    } catch (e) { /* ignore fallback errors */ }
                }
            } catch (ex) {
                console && console.error && console.error('Erro ao inicializar carousel:', ex);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>