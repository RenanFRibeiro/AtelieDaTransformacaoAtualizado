<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ateliê da Transformação</title>
    <meta name="description" content="Peças artesanais, móveis e projetos personalizados em madeira. Conheça o Ateliê da Transformação." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-modern.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100" style="--artisan-gold: #c58a58; --artisan-clay: #a85c3d; --artisan-wood: #241812;">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-artisan fixed-top">
            <div class="container-fluid navbar-inner">
                <a class="navbar-brand artisan-brand" asp-controller="Home" asp-action="Index" aria-label="Ateliê da Transformação - início">
                    <span class="brand-mark"><i class="bi bi-tree-fill" aria-hidden="true"></i></span>
                    <span class="serif-title brand-name">Ateliê da <strong>Transformação</strong></span>
                </a>

                <button class="navbar-toggler artisan-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav artisan-main-nav mx-auto">
                        <li class="nav-item"><a class="nav-link nav-link-artisan" asp-controller="Home" asp-action="Index">Coleção</a></li>
                        <li class="nav-item"><a class="nav-link nav-link-artisan" asp-controller="Home" asp-action="Gallery">Projetos</a></li>
                        <li class="nav-item"><a class="nav-link nav-link-artisan" asp-controller="Home" asp-action="About">Sobre</a></li>
                    </ul>

                    <div class="d-flex align-items-center header-actions-v3">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            if (!User.IsInRole("Admin"))
                            {
                                <a class="header-menu-link-v3 header-quote-link" asp-controller="Quote" asp-action="Index" title="Solicitar orçamento">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i><span>Orçamento</span>
                                </a>
                            }

                            if (User.IsInRole("Admin") || User.IsInRole("Funcionario") || User.IsInRole("Employee"))
                            {
                                <a class="header-menu-link-v3" asp-controller="Admin" asp-action="Index" title="Painel do Artesão">
                                    <i class="bi bi-sliders" aria-hidden="true"></i><span>Painel</span>
                                </a>
                            }

                            if (!User.IsInRole("Admin"))
                            {
                                <a class="header-menu-link-v3" asp-controller="Account" asp-action="Profile" title="Meu perfil">
                                    <i class="bi bi-person-circle" aria-hidden="true"></i><span>Meu perfil</span>
                                </a>
                                <a class="header-menu-link-v3" asp-controller="Order" asp-action="Index" title="Meus pedidos">
                                    <i class="bi bi-box-seam" aria-hidden="true"></i><span>Meus pedidos</span>
                                </a>
                                <a class="header-menu-link-v3 position-relative" asp-controller="Cart" asp-action="Index" title="Ver carrinho">
                                    <i class="bi bi-bag" aria-hidden="true"></i><span>Carrinho</span>
                                    <span class="badge cart-badge" id="cartCountBadge" style="display:none;">0</span>
                                </a>
                            }

                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="header-menu-link-v3 header-logout-v3" title="Sair">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Sair</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="header-menu-link-v3" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i><span>Entrar</span>
                            </a>
                            <a class="header-register-link" asp-controller="Account" asp-action="Register">
                                Criar conta <i class="bi bi-arrow-up-right ms-1"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="navbar-fixed-spacer" aria-hidden="true"></div>

    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index")
    {
        @await Component.InvokeAsync("Carousel")
    }

    <main role="main" class="flex-grow-1 site-main">
        @RenderBody()
    </main>

    <section class="benefits-section">
        <div class="home-container benefits-grid">
            <div class="benefit-item">
                <div class="benefit-icon"><i class="bi bi-shield-check"></i></div>
                <div><h2>Garantia de origem</h2><p>Materiais selecionados e processos pensados para valorizar cada criação.</p></div>
            </div>
            <div class="benefit-item">
                <div class="benefit-icon"><i class="bi bi-droplet-half"></i></div>
                <div><h2>Acabamento artesanal</h2><p>Cuidado em cada etapa para entregar textura, proteção e presença.</p></div>
            </div>
            <div class="benefit-item">
                <div class="benefit-icon"><i class="bi bi-chat-heart"></i></div>
                <div><h2>Atendimento direto</h2><p>Converse com quem entende do processo e transforme sua ideia em projeto.</p></div>
            </div>
        </div>
    </section>

    <footer class="artisan-footer">
        <div class="home-container">
            <div class="footer-grid">
                <div class="footer-brand-block">
                    <a asp-controller="Home" asp-action="Index" class="footer-brand serif-title">Ateliê da <strong>Transformação</strong></a>
                    <p>Peças artesanais, mobiliário e projetos personalizados com identidade, cuidado e acabamento.</p>
                </div>

                <div>
                    <span class="footer-heading">Navegação</span>
                    <a asp-controller="Home" asp-action="Index">Coleção</a>
                    <a asp-controller="Home" asp-action="Gallery">Projetos</a>
                    <a asp-controller="Home" asp-action="About">Sobre</a>
                </div>

                <div>
                    <span class="footer-heading">Atendimento</span>
                    <a asp-controller="Quote" asp-action="Index">Solicitar orçamento</a>
                    <a href="https://www.google.com/maps/search/?api=1&query=R.+Camomila%2C+99+-+Antigo+375+-+Jardim+Helena%2C+S%C3%A3o+Paulo+-+SP%2C+08090-530" target="_blank" rel="noopener noreferrer">Localização</a>
                    <a href="https://wa.me/5511999999999" target="_blank" rel="noopener noreferrer">WhatsApp</a>
                </div>
            </div>

            <div class="footer-bottom">
                <small>&copy; @System.DateTime.Now.Year Ateliê da Transformação. Todos os direitos reservados.</small>
                <div><a href="#">Termos de Uso</a><a href="#">Política de Privacidade</a></div>
            </div>
        </div>
    </footer>

    <a href="https://wa.me/5511999999999?text=Ol%C3%A1%21%20Visitei%20o%20site%20do%20Ateli%C3%AA%20da%20Transforma%C3%A7%C3%A3o%20e%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es." class="whatsapp-float" target="_blank" rel="noopener noreferrer" title="Falar conosco no WhatsApp" aria-label="Falar conosco no WhatsApp">
        <i class="bi bi-whatsapp"></i>
    </a>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const el = document.getElementById('artisanHeroCarousel');
            if (!el || !window.bootstrap || !bootstrap.Carousel) return;

            const carousel = bootstrap.Carousel.getOrCreateInstance(el, {
                interval: 6000,
                ride: 'carousel',
                pause: 'hover',
                keyboard: true,
                wrap: true
            });

            carousel.cycle();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
