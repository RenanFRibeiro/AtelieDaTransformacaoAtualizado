@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Painel de Controle";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#21150f" />
    <title>@pageTitle - Ateliê da Transformação</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-modern.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-modern.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <!-- Header mobile -->
        <header class="admin-mobile-header">
            <a asp-controller="Admin" asp-action="Index" class="admin-mobile-brand">
                Ateliê da <strong>Transformação</strong>
            </a>
            <button class="admin-mobile-menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebarMobile" aria-controls="adminSidebarMobile" aria-label="Abrir menu administrativo">
                <i class="bi bi-list fs-5"></i>
            </button>
        </header>

        <!-- Sidebar desktop -->
        <aside class="admin-sidebar" id="adminSidebar">
            <a asp-controller="Admin" asp-action="Index" class="admin-brand" aria-label="Voltar ao dashboard">
                <span class="admin-brand-mark"><i class="bi bi-tree-fill"></i></span>
                <span class="admin-brand-copy">
                    <span class="admin-brand-title">Ateliê da <strong>Transformação</strong></span>
                    <span class="admin-brand-caption">Painel do Ateliê</span>
                </span>
            </a>

            <nav class="admin-nav" aria-label="Navegação administrativa">
                <span class="admin-nav-label">Gestão</span>

                <a class="nav-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")"
                   asp-controller="Admin" asp-action="Index" title="Dashboard">
                    <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
                </a>

                <a class="nav-link @(currentController == "Admin" && (currentAction == "CreateProduct" || currentAction == "EditProduct") ? "active" : "")"
                   asp-controller="Admin" asp-action="CreateProduct" title="Nova peça">
                    <i class="bi bi-plus-square-fill"></i><span>Nova peça</span>
                </a>

                <a class="nav-link @(currentController == "Admin" && (currentAction == "Categories" || currentAction == "CreateCategory") ? "active" : "")"
                   asp-controller="Admin" asp-action="Categories" title="Categorias">
                    <i class="bi bi-collection-fill"></i><span>Categorias</span>
                </a>

                <a class="nav-link @(currentController == "AdminOrders" ? "active" : "")"
                   asp-controller="AdminOrders" asp-action="Index" title="Pedidos">
                    <i class="bi bi-receipt-cutoff"></i><span>Pedidos</span>
                </a>

                <span class="admin-nav-label mt-4">Atalhos</span>

                <a class="nav-link external" asp-controller="Home" asp-action="Index" title="Ver loja">
                    <i class="bi bi-shop"></i><span>Ver loja</span>
                </a>
            </nav>

            <div class="admin-sidebar-bottom">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var name = User.Identity.Name ?? "Administrador";
                    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
                    <div class="admin-user-card">
                        <span class="admin-user-avatar">@initials</span>
                        <span class="admin-user-copy">
                            <strong>@name</strong>
                            <span>Administrador</span>
                        </span>
                    </div>
                }

                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-logout">
                        <i class="bi bi-box-arrow-left me-2"></i><span>Sair do painel</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Menu mobile -->
        <div class="offcanvas offcanvas-start admin-offcanvas" tabindex="-1" id="adminSidebarMobile" aria-labelledby="adminSidebarMobileLabel">
            <div class="offcanvas-header border-bottom border-light border-opacity-10">
                <div>
                    <span class="admin-brand-title d-block" id="adminSidebarMobileLabel">Ateliê da <strong>Transformação</strong></span>
                    <small class="text-white-50">Painel administrativo</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column">
                <nav class="admin-nav p-0" aria-label="Navegação administrativa mobile">
                    <span class="admin-nav-label">Gestão</span>
                    <a class="nav-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")" data-bs-dismiss="offcanvas" asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
                    </a>
                    <a class="nav-link @(currentController == "Admin" && (currentAction == "CreateProduct" || currentAction == "EditProduct") ? "active" : "")" data-bs-dismiss="offcanvas" asp-controller="Admin" asp-action="CreateProduct">
                        <i class="bi bi-plus-square-fill"></i><span>Nova peça</span>
                    </a>
                    <a class="nav-link @(currentController == "Admin" && (currentAction == "Categories" || currentAction == "CreateCategory") ? "active" : "")" data-bs-dismiss="offcanvas" asp-controller="Admin" asp-action="Categories">
                        <i class="bi bi-collection-fill"></i><span>Categorias</span>
                    </a>
                    <a class="nav-link @(currentController == "AdminOrders" ? "active" : "")" data-bs-dismiss="offcanvas" asp-controller="AdminOrders" asp-action="Index">
                        <i class="bi bi-receipt-cutoff"></i><span>Pedidos</span>
                    </a>
                    <span class="admin-nav-label mt-4">Atalhos</span>
                    <a class="nav-link external" data-bs-dismiss="offcanvas" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-shop"></i><span>Ver loja</span>
                    </a>
                </nav>

                <div class="mt-auto pt-4">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="admin-logout">
                            <i class="bi bi-box-arrow-left me-2"></i><span>Sair do painel</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="admin-main-wrap">
            <header class="admin-topbar">
                <button type="button" class="admin-icon-button admin-mobile-toggle" id="adminSidebarToggle" aria-label="Recolher ou expandir menu" title="Recolher menu">
                    <i class="bi bi-layout-sidebar-inset"></i>
                </button>

                <div class="admin-topbar-title">
                    <small>Painel administrativo</small>
                    <strong>@pageTitle</strong>
                </div>

                <div class="admin-topbar-actions">
                    <a asp-controller="Home" asp-action="Index" class="admin-top-action" title="Abrir loja">
                        <i class="bi bi-shop"></i><span>Ver loja</span>
                    </a>
                    <a asp-controller="Admin" asp-action="CreateProduct" class="admin-top-action primary" title="Cadastrar nova peça">
                        <i class="bi bi-plus-lg"></i><span>Nova peça</span>
                    </a>
                </div>
            </header>

            <main class="admin-content" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const body = document.body;
            const toggle = document.getElementById('adminSidebarToggle');
            const storageKey = 'atelie-admin-sidebar-collapsed';

            // Mantém a preferência de largura do menu no desktop.
            if (window.innerWidth >= 992 && localStorage.getItem(storageKey) === 'true') {
                body.classList.add('admin-collapsed');
            }

            if (toggle) {
                toggle.addEventListener('click', function () {
                    body.classList.toggle('admin-collapsed');
                    localStorage.setItem(storageKey, body.classList.contains('admin-collapsed'));
                });
            }

            // Ao mudar para mobile, remove o estado colapsado para evitar layout inconsistente.
            window.addEventListener('resize', function () {
                if (window.innerWidth < 992) body.classList.remove('admin-collapsed');
            });

            // Feedback visual padronizado para os formulários administrativos.
            document.querySelectorAll('.form-control, .form-select').forEach(function (input) {
                input.addEventListener('focus', function () { this.classList.add('form-active'); });
                input.addEventListener('blur', function () { this.classList.remove('form-active'); });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
