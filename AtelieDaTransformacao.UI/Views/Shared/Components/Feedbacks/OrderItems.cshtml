@model IReadOnlyList<AtelieDaTransformacao.Application.ViewModels.OrderFeedbackItemViewModel>

@if (Model.Count > 0)
{
    <div class="order-feedback-area mt-4 pt-4 border-top">

        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">

            <div>

                <span class="text-uppercase text-gold fw-bold small">
                    Sua experiência
                </span>

                <h2 class="h4 fw-bold mb-0">
                    Avaliações dos produtos
                </h2>

            </div>

        </div>

        <div class="row g-3">

            @foreach (var item in Model)
            {
                <div class="col-12 col-lg-6">

                    <div class="feedback-order-card h-100">

                        <div class="d-flex justify-content-between align-items-start gap-3">

                            <div>

                                <div class="small text-muted">
                                    Produto comprado
                                </div>

                                <h3 class="h5 fw-bold mb-1">
                                    @item.ProdutoNome
                                </h3>

                                <div class="small text-muted">
                                    Quantidade:
                                    @item.Quantidade
                                </div>

                            </div>

                            @if (item.Feedback is null)
                            {
                                <span class="badge text-bg-warning rounded-pill">
                                    Pendente
                                </span>
                            }
                            else
                            {
                                <span class="badge text-bg-success rounded-pill">
                                    Produto Avaliado
                                </span>
                            }

                        </div>

                        @if (item.Feedback is null)
                        {
                            <div class="mt-3">

                                <p class="text-muted small mb-3">
                                    Este pedido foi entregue.
                                    Conte como foi sua experiência
                                    com esta peça.
                                </p>

                                <a asp-controller="Feedback"
                                   asp-action="Create"
                                   asp-route-pedidoId="@item.PedidoId"
                                   asp-route-produtoId="@item.ProdutoId"
                                   class="btn btn-artisan rounded-pill px-4">

                                    <i class="bi bi-star me-1"></i>

                                    Avaliar Produto

                                </a>

                            </div>
                        }
                        else
                        {
                            <div class="mt-3">

                                <div class="feedback-inline-stars mb-2"
                                     aria-label="@item.Feedback.Nota de 5 estrelas">

                                    @for (
                                        var star = 1;
                                        star <= 5;
                                        star++)
                                    {
                                        <i class="bi @(star <= item.Feedback.Nota ? "bi-star-fill" : "bi-star")"></i>
                                    }

                                </div>

                                <p class="mb-3">
                                    @item.Feedback.Comentario
                                </p>

                                @if (!string.IsNullOrWhiteSpace(
                                    item.Feedback.ImagemUrl))
                                {
                                    <img src="@item.Feedback.ImagemUrl"
                                         alt="Foto enviada na avaliação de @item.ProdutoNome"
                                         class="feedback-inline-image" />
                                }

                                <div class="small text-muted mt-2">

                                    Publicado em
                                     @(item.Feedback.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                                </div>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>

    </div>

    <style>

        .feedback-order-card {
            padding: 1.25rem;
            border:
                1px solid rgba(0, 0, 0, .08);
            border-radius: 20px;
            background: #faf9f7;
        }

        .feedback-inline-stars {
            color: #d39b42;
            letter-spacing: .08em;
        }

        .feedback-inline-image {
            display: block;
            width: min(100%, 280px);
            max-height: 230px;
            object-fit: cover;
            border-radius: 16px;
        }

    </style>
}