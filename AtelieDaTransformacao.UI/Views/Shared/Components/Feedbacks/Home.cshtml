@model IReadOnlyList<AtelieDaTransformacao.Application.ViewModels.FeedbackCardViewModel>

@if (Model.Count > 0)
{
    <section class="feedback-section" aria-labelledby="feedback-title">
        <div class="home-container">
            <div class="feedback-heading">
                <div>
                    <span class="eyebrow">QUEM JÁ COMPROU</span>
                    <h2 id="feedback-title" class="serif-title">Histórias de quem recebeu.</h2>
                    <p>Avaliações reais de clientes que compraram e receberam suas peças.</p>
                </div>
            </div>

            @if (Model.Count > 3)
            {
                <div id="approvedFeedbackCarousel"
                     class="feedback-carousel"
                     data-feedback-carousel
                     data-interval="5000">
                    <div class="feedback-carousel-viewport">
                        <div class="feedback-carousel-track">
                            @foreach (var feedback in Model.Skip(Math.Max(0, Model.Count - 3)))
                            {
                                <article class="feedback-card feedback-card-carousel feedback-card-clone" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(feedback.ImagemUrl))
                                    {
                                        <a href="#"
                                          data-feedback-image="@feedback.ImagemUrl"
                                     data-feedback-image="@feedback.ImagemUrl"
                                           class="feedback-card-image feedback-product-link"
                                           tabindex="-1"
                                           aria-label="Abrir a imagem publicada pelo cliente">
                                            <img src="@feedback.ImagemUrl"
                                                 alt="Foto enviada pelo cliente para a avaliação de @feedback.ProdutoNome"
                                                 loading="lazy" />
                                            <span class="feedback-product-overlay"><i class="bi bi-arrows-fullscreen"></i> Ampliar imagem</span>
                                        </a>
                                    }
                                    <div class="feedback-card-body">
                                        <div class="feedback-card-stars" aria-label="@feedback.Nota de 5 estrelas">
                                            @for (var star = 1; star <= 5; star++)
                                            {
                                                <i class="bi @(star <= feedback.Nota ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                        <blockquote>“@feedback.Comentario”</blockquote>
                                        <div class="feedback-card-footer">
                                            <div><strong>@feedback.PublicName</strong><span>@feedback.ProdutoNome</span></div>
                                            <time datetime="@feedback.DataCriacao.ToString("O")">@feedback.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")</time>
                                        </div>
                                    </div>
                                </article>
                            }

                            @foreach (var feedback in Model)
                            {
                                <article class="feedback-card feedback-card-carousel">
                                    @if (!string.IsNullOrWhiteSpace(feedback.ImagemUrl))
                                    {
                                        <a href="#"
                                          data-feedback-image="@feedback.ImagemUrl"
                                     data-feedback-image="@feedback.ImagemUrl"
                                           class="feedback-card-image feedback-product-link"
                                           aria-label="Abrir a imagem publicada pelo cliente">
                                            <img src="@feedback.ImagemUrl"
                                                 alt="Foto enviada pelo cliente para a avaliação de @feedback.ProdutoNome"
                                                 loading="lazy" />
                                            <span class="feedback-product-overlay"><i class="bi bi-arrows-fullscreen"></i> Ampliar imagem</span>
                                        </a>
                                    }
                                    <div class="feedback-card-body">
                                        <div class="feedback-card-stars" aria-label="@feedback.Nota de 5 estrelas">
                                            @for (var star = 1; star <= 5; star++)
                                            {
                                                <i class="bi @(star <= feedback.Nota ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                        <blockquote>“@feedback.Comentario”</blockquote>
                                        <div class="feedback-card-footer">
                                            <div><strong>@feedback.PublicName</strong><span>@feedback.ProdutoNome</span></div>
                                            <time datetime="@feedback.DataCriacao.ToString("O")">@feedback.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")</time>
                                        </div>
                                    </div>
                                </article>
                            }

                            @foreach (var feedback in Model.Take(3))
                            {
                                <article class="feedback-card feedback-card-carousel feedback-card-clone" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(feedback.ImagemUrl))
                                    {
                                        <a href="#"
                                          data-feedback-image="@feedback.ImagemUrl"
                                     data-feedback-image="@feedback.ImagemUrl"
                                           class="feedback-card-image feedback-product-link"
                                           tabindex="-1"
                                           aria-label="Abrir a imagem publicada pelo cliente">
                                            <img src="@feedback.ImagemUrl"
                                                 alt="Foto enviada pelo cliente para a avaliação de @feedback.ProdutoNome"
                                                 loading="lazy" />
                                            <span class="feedback-product-overlay"><i class="bi bi-arrows-fullscreen"></i> Ampliar imagem</span>
                                        </a>
                                    }
                                    <div class="feedback-card-body">
                                        <div class="feedback-card-stars" aria-label="@feedback.Nota de 5 estrelas">
                                            @for (var star = 1; star <= 5; star++)
                                            {
                                                <i class="bi @(star <= feedback.Nota ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                        <blockquote>“@feedback.Comentario”</blockquote>
                                        <div class="feedback-card-footer">
                                            <div><strong>@feedback.PublicName</strong><span>@feedback.ProdutoNome</span></div>
                                            <time datetime="@feedback.DataCriacao.ToString("O")">@feedback.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")</time>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    </div>

                    <button class="feedback-carousel-control feedback-carousel-prev" type="button" data-feedback-prev aria-label="Feedback anterior">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button class="feedback-carousel-control feedback-carousel-next" type="button" data-feedback-next aria-label="Próximo feedback">
                        <i class="bi bi-chevron-right"></i>
                    </button>

                    <div class="feedback-carousel-indicators" data-feedback-indicators>
                        @for (var index = 0; index < Model.Count; index++)
                        {
                            <button type="button" data-feedback-dot="@index" class="@(index == 0 ? "active" : "")" aria-label="Ir para feedback @(index + 1)"></button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="feedback-grid">
                    @foreach (var feedback in Model)
                    {
                        <article class="feedback-card">
                            @if (!string.IsNullOrWhiteSpace(feedback.ImagemUrl))
                            {
                                <a href="#"
                                   data-feedback-image="@feedback.ImagemUrl"
                                    class="feedback-card-image feedback-product-link"
                                   aria-label="Abrir a imagem publicada pelo cliente">
                                    <img src="@feedback.ImagemUrl"
                                         alt="Foto enviada pelo cliente para a avaliação de @feedback.ProdutoNome"
                                         loading="lazy" />
                                    <span class="feedback-product-overlay"><i class="bi bi-arrows-fullscreen"></i> Ampliar imagem</span>
                                </a>
                            }
                            <div class="feedback-card-body">
                                <div class="feedback-card-stars" aria-label="@feedback.Nota de 5 estrelas">
                                    @for (var star = 1; star <= 5; star++)
                                    {
                                        <i class="bi @(star <= feedback.Nota ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                </div>
                                <blockquote>“@feedback.Comentario”</blockquote>
                                <div class="feedback-card-footer">
                                    <div><strong>@feedback.PublicName</strong><span>@feedback.ProdutoNome</span></div>
                                    <time datetime="@feedback.DataCriacao.ToString("O")">@feedback.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")</time>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <style>
        .feedback-section { padding: 5rem 0; background: #f7f3ec; }
        .feedback-heading { display:flex; justify-content:space-between; align-items:end; margin-bottom:2rem; }
        .feedback-heading h2 { margin-bottom:.5rem; }
        .feedback-heading p { max-width:680px; color:#6d6a65; margin-bottom:0; }
        .feedback-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; }
        .feedback-card { display:flex; flex-direction:column; overflow:hidden; background:#fff; border:1px solid rgba(0,0,0,.07); border-radius:24px; box-shadow:0 12px 35px rgba(0,0,0,.06); }
        .feedback-card-image { aspect-ratio:16/10; overflow:hidden; background:#eee; }
        .feedback-card-image img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .55s cubic-bezier(.16,1,.3,1); }
        .feedback-product-link { display:block; position:relative; color:inherit; text-decoration:none; cursor:pointer; }
        .feedback-product-link:hover img { transform:scale(1.045); }
        .feedback-product-overlay { position:absolute; left:50%; bottom:14px; transform:translate(-50%,8px); opacity:0; pointer-events:none; display:inline-flex; align-items:center; gap:7px; padding:8px 13px; border-radius:999px; background:rgba(33,21,15,.88); color:#fff; font-size:.76rem; font-weight:700; white-space:nowrap; transition:opacity .22s ease, transform .22s ease; }
        .feedback-product-link:hover .feedback-product-overlay, .feedback-product-link:focus-visible .feedback-product-overlay { opacity:1; transform:translate(-50%,0); }
        .feedback-card-body { display:flex; flex-direction:column; gap:1rem; height:100%; padding:1.5rem; }
        .feedback-card-stars { color:#d39b42; letter-spacing:.08em; }
        .feedback-card blockquote { flex:1; margin:0; color:#292722; font-size:1.02rem; line-height:1.7; }
        .feedback-card-footer { display:flex; justify-content:space-between; align-items:end; gap:1rem; padding-top:1rem; border-top:1px solid rgba(0,0,0,.07); }
        .feedback-card-footer div { display:flex; flex-direction:column; gap:.15rem; }
        .feedback-card-footer strong { font-size:.95rem; }
        .feedback-card-footer span,.feedback-card-footer time { color:#77736d; font-size:.82rem; }

        .feedback-carousel { position:relative; padding:0 3.75rem 3.25rem; --feedback-gap:1.5rem; --feedback-visible:3; }
        .feedback-carousel-viewport { overflow:hidden; width:100%; }
        .feedback-carousel-track { display:flex; gap:var(--feedback-gap); align-items:stretch; will-change:transform; transition:transform .68s cubic-bezier(.22,.75,.25,1); }
        .feedback-card-carousel { flex:0 0 calc((100% - (var(--feedback-gap) * (var(--feedback-visible) - 1))) / var(--feedback-visible)); min-width:0; }
        .feedback-carousel-control { position:absolute; z-index:3; top:50%; transform:translateY(-50%); width:42px; height:42px; display:flex; align-items:center; justify-content:center; border:0; border-radius:50%; background:rgba(40,30,25,.9); color:#fff; box-shadow:0 8px 20px rgba(0,0,0,.12); opacity:.92; transition:transform .2s ease, opacity .2s ease, background .2s ease; }
        .feedback-carousel-control:hover { transform:translateY(-50%) scale(1.06); opacity:1; background:rgba(33,21,15,.98); }
        .feedback-carousel-prev { left:.25rem; }
        .feedback-carousel-next { right:.25rem; }
        .feedback-carousel-indicators { position:absolute; left:0; right:0; bottom:0; display:flex; justify-content:center; align-items:center; gap:8px; margin:0; }
        .feedback-carousel-indicators button { width:7px; height:7px; padding:0; border:0; border-radius:50%; background:#b9afa4; opacity:.65; transition:width .25s ease, opacity .25s ease, background .25s ease; }
        .feedback-carousel-indicators button.active { width:22px; border-radius:999px; background:#a85c3d; opacity:1; }
        .feedback-card-clone { pointer-events:auto; }

        @@media (max-width:991.98px) {
            .feedback-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
            .feedback-carousel { padding-left:3.25rem; padding-right:3.25rem; --feedback-visible:2; }
        }
        @@media (max-width:575.98px) {
            .feedback-section { padding:3.5rem 0; }
            .feedback-grid { grid-template-columns:1fr; }
            .feedback-carousel { padding:0 2.5rem 3rem; --feedback-visible:1; }
            .feedback-carousel-control { width:38px; height:38px; }
            .feedback-carousel-prev { left:.15rem; }
            .feedback-carousel-next { right:.15rem; }
            .feedback-card-body { padding:1.25rem; }
        }
    </style>

    <div class="feedback-image-modal" data-feedback-image-modal aria-hidden="true">
        <div class="feedback-image-modal-backdrop" data-feedback-image-close></div>
        <div class="feedback-image-modal-dialog" role="dialog" aria-modal="true" aria-label="Imagem do feedback">
            <button type="button" class="feedback-image-modal-close" data-feedback-image-close aria-label="Fechar imagem">×</button>
            <img class="feedback-image-modal-img" data-feedback-image-preview src="" alt="Imagem publicada no feedback" />
        </div>
    </div>

    <style>
        .feedback-image-modal {
            position: fixed;
            inset: 0;
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .22s ease, visibility .22s ease;
        }
        .feedback-image-modal.is-open {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }
        .feedback-image-modal-backdrop {
            position: absolute;
            inset: 0;
            background: rgba(20,14,10,.84);
            backdrop-filter: blur(4px);
        }
        .feedback-image-modal-dialog {
            position: relative;
            z-index: 2;
            max-width: min(1100px, 92vw);
            max-height: 90vh;
            display: flex;
            align-items: center;
            justify-content: center;
            transform: scale(.96);
            transition: transform .25s ease;
        }
        .feedback-image-modal.is-open .feedback-image-modal-dialog {
            transform: scale(1);
        }
        .feedback-image-modal-img {
            display: block;
            max-width: min(1100px, 92vw);
            max-height: 88vh;
            width: auto;
            height: auto;
            object-fit: contain;
            border-radius: 16px;
            box-shadow: 0 20px 70px rgba(0,0,0,.4);
        }
        .feedback-image-modal-close {
            position: fixed;
            z-index: 100000;
            top: 18px;
            right: 18px;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 0 3px;
            border: 2px solid rgba(255,255,255,.9);
            border-radius: 50%;
            background: #2b1a12;
            color: #fff;
            font-family: Arial, sans-serif;
            font-size: 32px;
            font-weight: 400;
            line-height: 1;
            cursor: pointer;
            box-shadow: 0 8px 24px rgba(0,0,0,.45);
            appearance: none;
            -webkit-appearance: none;
            transition: transform .18s ease, background .18s ease;
        }
        .feedback-image-modal-close:hover {
            transform: scale(1.08);
            background: #43271b;
        }
        .feedback-image-modal-close:focus-visible {
            outline: 3px solid #fff;
            outline-offset: 3px;
        }
        @@media (max-width: 575.98px) {
            .feedback-image-modal { padding: 1rem; }
            .feedback-image-modal-img { max-width: 96vw; max-height: 82vh; border-radius: 12px; }
            .feedback-image-modal-close { top: 12px; right: 12px; width: 44px; height: 44px; font-size: 29px; }
        }
    </style>

    <script>
        (() => {
            const initFeedbackImageModal = () => {
                const modal = document.querySelector('[data-feedback-image-modal]');
                if (!modal || modal.dataset.initialized === 'true') return;

                const preview = modal.querySelector('[data-feedback-image-preview]');
                const close = () => {
                    modal.classList.remove('is-open');
                    modal.setAttribute('aria-hidden', 'true');
                    preview.removeAttribute('src');
                    document.body.style.overflow = '';
                };

                // Delegação de evento: funciona também nas cópias do carrossel.
                document.addEventListener('click', event => {
                    const link = event.target.closest('[data-feedback-image]');
                    if (link) {
                        event.preventDefault();
                        event.stopPropagation();
                        const imageUrl = link.getAttribute('data-feedback-image');
                        if (!imageUrl) return;
                        preview.src = imageUrl;
                        modal.classList.add('is-open');
                        modal.setAttribute('aria-hidden', 'false');
                        document.body.style.overflow = 'hidden';
                        return;
                    }

                    if (event.target.closest('[data-feedback-image-close]')) {
                        event.preventDefault();
                        close();
                    }
                });

                document.addEventListener('keydown', event => {
                    if (event.key === 'Escape' && modal.classList.contains('is-open')) {
                        close();
                    }
                });

                modal.dataset.initialized = 'true';
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initFeedbackImageModal);
            } else {
                initFeedbackImageModal();
            }
        })();
    </script>

    @if (Model.Count > 3)
    {
        <script>
            (() => {
                const initFeedbackCarousel = () => {
                    const carousel = document.querySelector('[data-feedback-carousel]');
                    if (!carousel || carousel.dataset.initialized === 'true') return;

                    const track = carousel.querySelector('.feedback-carousel-track');
                    const cards = [...track.querySelectorAll('.feedback-card-carousel')];
                    const total = @Model.Count;
                    let position = 3;
                    let timerId = null;
                    let isAnimating = false;

                    const getVisible = () => window.innerWidth <= 575.98 ? 1 : (window.innerWidth <= 991.98 ? 2 : 3);
                    const getStep = () => {
                        const card = cards[0];
                        if (!card) return 0;
                        const gap = parseFloat(getComputedStyle(track).gap) || 0;
                        return card.getBoundingClientRect().width + gap;
                    };

                    const updateDots = () => {
                        const realIndex = ((position - 3) % total + total) % total;
                        carousel.querySelectorAll('[data-feedback-dot]').forEach(dot => {
                            dot.classList.toggle('active', Number(dot.dataset.feedbackDot) === realIndex);
                        });
                    };

                    const moveTo = (nextPosition, animate = true) => {
                        position = nextPosition;
                        track.style.transition = animate ? 'transform .68s cubic-bezier(.22,.75,.25,1)' : 'none';
                        track.style.transform = `translate3d(${-position * getStep()}px,0,0)`;
                        updateDots();
                    };

                    const next = () => {
                        if (isAnimating) return;
                        isAnimating = true;
                        moveTo(position + 1, true);
                    };

                    const prev = () => {
                        if (isAnimating) return;
                        isAnimating = true;
                        moveTo(position - 1, true);
                    };

                    track.addEventListener('transitionend', () => {
                        const maxRealPosition = 3 + total - getVisible();
                        if (position >= 3 + total) {
                            moveTo(3, false);
                        } else if (position < 3) {
                            moveTo(3 + total - getVisible(), false);
                        }
                        isAnimating = false;
                    });

                    carousel.querySelector('[data-feedback-next]')?.addEventListener('click', () => { next(); restart(); });
                    carousel.querySelector('[data-feedback-prev]')?.addEventListener('click', () => { prev(); restart(); });
                    carousel.querySelectorAll('[data-feedback-dot]').forEach(dot => {
                        dot.addEventListener('click', () => {
                            if (isAnimating) return;
                            const target = Number(dot.dataset.feedbackDot);
                            moveTo(3 + target, true);
                            restart();
                        });
                    });

                    const restart = () => {
                        clearInterval(timerId);
                        timerId = setInterval(next, Number(carousel.dataset.interval) || 5000);
                    };

                    window.addEventListener('resize', () => moveTo(position, false));
                    carousel.dataset.initialized = 'true';
                    requestAnimationFrame(() => moveTo(3, false));
                    restart();
                };

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initFeedbackCarousel);
                } else {
                    initFeedbackCarousel();
                }
            })();
        </script>
    }
}
