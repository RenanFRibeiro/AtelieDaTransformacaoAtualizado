@model AtelieDaTransformacao.Application.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Meu Carrinho";
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="text-uppercase text-gold fw-bold small">Sua seleção</span>
            <h1 class="serif-title fw-bold mb-1">Meu Carrinho</h1>
            <p class="text-muted mb-0">Confira suas peças antes de falar com o vendedor.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Continuar comprando
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="card card-wood border-0 shadow-sm rounded-4 text-center p-5">
            <i class="bi bi-cart-x display-1 text-gold"></i>
            <h2 class="serif-title fw-bold mt-3">Seu carrinho está vazio</h2>
            <p class="text-muted mb-4">Escolha uma peça da coleção para começar sua seleção.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-artisan rounded-pill px-4">
                <i class="bi bi-grid me-1"></i> Ver coleção
            </a>
        </div>
    }
    else
    {
        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
                @foreach (var item in Model.Items)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                        <div class="card-body p-3 p-md-4">
                            <div class="row align-items-center g-3">
                                <div class="col-4 col-md-2">
                                    <img src="@(string.IsNullOrWhiteSpace(item.Image) ? "/images/placeholder.jpg" : item.Image)"
                                         alt="@item.Title" class="img-fluid rounded-3" style="height:100px;width:100%;object-fit:cover;" />
                                </div>
                                <div class="col-8 col-md-4">
                                    <span class="small text-muted">Peça</span>
                                    <h5 class="fw-bold mb-1">@item.Title</h5>
                                    <span class="text-gold fw-bold">R$ @item.Price.ToString("N2")</span>
                                </div>
                                <div class="col-7 col-md-3">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <form asp-action="Decrease" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-outline-secondary rounded-circle" style="width:38px;height:38px;">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                        </form>
                                        <span class="fw-bold px-2">@item.Quantity</span>
                                        <form asp-action="Increase" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-outline-secondary rounded-circle" style="width:38px;height:38px;">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                <div class="col-4 col-md-2 text-md-end">
                                    <span class="small text-muted d-block">Subtotal</span>
                                    <strong>R$ @item.Subtotal.ToString("N2")</strong>
                                </div>
                                <div class="col-1 text-end">
                                    <form asp-action="Remove" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-link text-danger p-0" title="Remover">
                                            <i class="bi bi-trash fs-5"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <form asp-action="Clear" method="post" class="text-end" onsubmit="return confirm('Deseja realmente esvaziar o carrinho?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger rounded-pill">
                        <i class="bi bi-trash me-1"></i> Esvaziar carrinho
                    </button>
                </form>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 sticky-lg-top" style="top:100px;">
                    <div class="card-body p-4">
                        <span class="text-uppercase text-gold fw-bold small">Resumo</span>
                        <h3 class="serif-title fw-bold mb-4">Sua compra</h3>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Itens</span>
                            <strong>@Model.TotalItems</strong>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fw-bold">Total</span>
                            <span class="fs-4 fw-bold">R$ @Model.Total.ToString("N2")</span>
                        </div>

                        <a href="@ViewBag.WhatsAppLink" target="_blank" rel="noopener" class="btn btn-success btn-lg w-100 rounded-pill py-3" style="background-color:#25d366;border:none;">
                            <i class="bi bi-whatsapp me-2"></i> Finalizar pelo WhatsApp
                        </a>

                        <p class="small text-muted text-center mt-3 mb-0">
                            O site monta a mensagem com os itens e abre o WhatsApp do vendedor. O pagamento e a entrega serão combinados diretamente com ele.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
